<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<title>第 30 小时 · 系统设计（二）· 设计模式与人机交互 · 阿甘系分 48 小时冲刺</title>
<meta name="description" content="系统分析师 48 小时冲刺手册 · 三科覆盖 + 案例论文专项 + 交互答题">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%233d5a40'/><text x='16' y='22' font-size='15' font-weight='700' fill='%23fbfaf6' text-anchor='middle' font-family='sans-serif'>48</text></svg>">
<meta name="build-stamp" content="2026-10-05 09:05:06">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<style>/* ═══════════════════════════════════════════════════
   阿甘系分 48 小时冲刺 · 设计系统
   风格：暖墨绿调 / 教科书质感 / 现代极简
   ═══════════════════════════════════════════════════ */

/* ---------- 1. 设计令牌 ---------- */
:root{
  /* 暖墨绿调 —— 沉稳、书卷气，区别于技术文档的"文档蓝" */
  --bg:#fbfaf6;
  --bg-alt:#f2f0e9;
  --bg-card:#fffdf9;
  --bg-deep:#edeae1;

  --fg:#1b211c;
  --fg-2:#4d574e;
  --fg-3:#7d877f;
  --fg-inv:#fbfaf6;

  --line:#e0ddd4;
  --line-2:#cdc9bd;

  --accent:#3d5a40;
  --fs-base:16.5px;
  --accent-2:#5a8a62;
  --accent-3:#7ea888;
  --accent-soft:rgba(61,90,64,.075);
  --accent-soft-2:rgba(61,90,64,.14);
  --accent-glow:rgba(90,138,98,.25);

  --warn:#b8860b;
  --warn-bg:#fdf7e6;
  --warn-line:#e0b252;
  --warn-fg:#6b4e06;

  --tip:#2d6a4f;
  --tip-bg:#e9f4ec;
  --tip-line:#4a8a63;
  --tip-fg:#1d4630;

  --danger:#b33636;
  --danger-bg:#fbeeee;
  --danger-line:#dd7d7d;

--gold:#a67c00;
--gold-bg:#fbf6e3;
/* 记忆口诀框（紫）——与墨绿主色同属低饱和冷调，不抢主色 */
--mem:#6d4a8f;
--mem-bg:#f4f1f8;
--mem-line:#8b6bb0;
--mem-fg:#4a3460;

  --radius:10px;
  --radius-lg:16px;
  --radius-sm:7px;
  /* 布局宽度：正文栏要够宽才不会在大屏上显得"空而窄"。
     1440px 视口下 = 236(toc) + 56(gap) + 700(main) + 2×40(padding) ≈ 1072，居中留白更均衡。 */
  --maxw:1180px;
  --toc-w:236px;
  --gap:56px;
  --pad-x:40px;
  --shadow-1:0 1px 2px rgba(28,34,29,.04), 0 2px 8px rgba(28,34,29,.03);
  --shadow-2:0 4px 16px rgba(28,34,29,.07), 0 1px 3px rgba(28,34,29,.04);
  --shadow-3:0 12px 32px rgba(28,34,29,.10);

  --font:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Noto Sans SC","Microsoft YaHei",sans-serif;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  --mono:ui-monospace,"SF Mono","JetBrains Mono","Fira Code",Menlo,Consolas,monospace;
  --serif:"Songti SC","STSong","Source Han Serif SC","Noto Serif CJK SC","Source Han Serif CN","Times New Roman",SimSun,serif;
  --measure:760px;

  --ease:cubic-bezier(.4,0,.2,1);
}

html[data-theme="dark"]{
  --bg:#141715;
  --bg-alt:#1c201d;
  --bg-card:#191d1a;
  --bg-deep:#232824;

  --fg:#dde5de;
  --fg-2:#a0aaa2;
  --fg-3:#6c766e;
  --fg-inv:#141715;

  --line:#2b302c;
  --line-2:#3a413b;

  --accent:#8bb195;
  --accent-2:#a9c9b1;
  --accent-3:#c3dcc8;
  --accent-soft:rgba(139,177,149,.10);
  --accent-soft-2:rgba(139,177,149,.18);
  --accent-glow:rgba(139,177,149,.25);

  --warn:#d9b04a;
  --warn-bg:#252010;
  --warn-line:#7d6428;
  --warn-fg:#e8d08a;

  --tip:#7fc79b;
  --tip-bg:#16241c;
  --tip-line:#3d7a55;
  --tip-fg:#a8dcbd;

  --danger:#e08585;
  --danger-bg:#251818;
  --danger-line:#8a4545;

--gold:#d9bb6a;
--gold-bg:#262210;
--mem:#c9b0e0;
--mem-bg:#221a2c;
--mem-line:#7d5fa0;
--mem-fg:#dccdf0;

  --shadow-1:0 1px 2px rgba(0,0,0,.16);
  --shadow-2:0 4px 16px rgba(0,0,0,.26);
  --shadow-3:0 12px 32px rgba(0,0,0,.36);
}

/* ---------- 2. 基础重置 ---------- */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

html{
  scroll-behavior:smooth;
  -webkit-text-size-adjust:100%;
  scroll-padding-top:80px;
  font-size:var(--fs-base);     /* 字号可调（- / + 快捷键），默认 16.5px */
}

body{
  font-family:var(--font);
  background:var(--bg);
  color:var(--fg);
  font-size:16.5px;
  line-height:1.88;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  font-variant-numeric:tabular-nums;
}

::selection{background:var(--accent-soft-2);color:var(--accent)}

img{max-width:100%;height:auto}

/* 焦点可见性（键盘导航） */
:focus-visible{outline:2px solid var(--accent-2);outline-offset:2px;border-radius:4px}

/* ---------- 3. 阅读进度条 ---------- */
.read-progress{
  position:fixed;top:0;left:0;right:0;height:2.5px;
  background:var(--accent-2);
  transform-origin:left;transform:scaleX(0);
  width:100%;
  z-index:1000;
  transition:transform .1s linear;
}

/* ---------- 4. 顶部导航 ---------- */
.topbar{
  position:sticky;top:0;z-index:500;
  height:54px;
  display:flex;align-items:center;gap:24px;
  padding:0 28px;
  background:color-mix(in srgb, var(--bg) 85%, transparent);
  backdrop-filter:saturate(180%) blur(14px);
  -webkit-backdrop-filter:saturate(180%) blur(14px);
  border-bottom:1px solid var(--line);
}
.topbar::after{
  content:'';position:absolute;inset:0;pointer-events:none;
  box-shadow:0 1px 0 var(--line);
}
@media (prefers-reduced-motion:reduce){
  .read-progress{transition:none}
  *{animation-duration:.01ms!important;transition-duration:.01ms!important}
}

.brand{
  display:flex;align-items:baseline;gap:8px;
  font-weight:700;font-size:15.5px;letter-spacing:-.2px;
  color:var(--accent);text-decoration:none;white-space:nowrap;
  flex-shrink:0;
}
.brand-mark{
  display:inline-flex;align-items:center;justify-content:center;
  width:22px;height:22px;border-radius:6px;
  background:var(--accent);color:var(--fg-inv);
  font-size:12px;font-weight:700;
  align-self:center;
}
.brand-sub{color:var(--fg-3);font-weight:400;font-size:13px}

/* ---------- 顶栏导航：胶囊触发器 + 分组下拉面板 ----------
   14 个学时平铺会挤爆顶栏（尤其 1280px 以下），改成「当前页胶囊 + 分组面板」。
   面板按模块分组（第一篇/第二篇/专项），底部给出待上线进度与上一章/下一章。 */
.nav{position:relative;margin-left:auto;flex-shrink:0}
.nav-trigger{
  display:inline-flex;align-items:center;gap:8px;
  max-width:min(46vw,340px);
  padding:6px 12px 6px 8px;
  border:1px solid var(--line);
  border-radius:999px;
  background:var(--bg-card);
  color:var(--fg-2);font:inherit;font-size:13.5px;
  cursor:pointer;
  transition:border-color .18s var(--ease), background .18s var(--ease), color .18s var(--ease);
}
.nav-trigger:hover{border-color:var(--accent);color:var(--accent)}
.nav-trigger:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.nav-trigger-code{
  flex-shrink:0;
  padding:2px 8px;border-radius:999px;
  background:var(--accent);color:var(--fg-inv);
  font-size:11.5px;font-weight:700;letter-spacing:.02em;
}
.nav-trigger-label{
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.nav-caret{width:12px;height:12px;flex-shrink:0;transition:transform .2s var(--ease)}
.nav.open .nav-caret{transform:rotate(180deg)}

.nav-panel{
  position:absolute;top:calc(100% + 10px);right:0;
  width:min(88vw,392px);
  max-height:min(74vh,620px);
  display:flex;flex-direction:column;
  background:var(--bg-card);
  border:1px solid var(--line);
  border-radius:var(--radius);
  box-shadow:var(--shadow-2);
  overflow:hidden;
  z-index:520;
}
.nav-panel[hidden]{display:none}
.nav-panel-scroll{
  overflow-y:auto;overscroll-behavior:contain;
  padding:10px 8px 12px;
  flex:1;
  -webkit-overflow-scrolling:touch;
}
.nav-group + .nav-group{margin-top:12px;padding-top:12px;border-top:1px solid var(--line)}
.nav-group-solo{padding-bottom:2px}
.nav-group-solo + .nav-group{margin-top:8px;padding-top:8px}
.nav-group-title{
  padding:0 10px 6px;
  font-size:11.5px;font-weight:700;letter-spacing:.06em;
  color:var(--fg-3);text-transform:none;
}
.nav-item{
  display:flex;align-items:center;gap:9px;
  padding:6px 10px;border-radius:var(--radius-sm);
  font-size:13.5px;color:var(--fg-2);text-decoration:none;
  transition:background .15s var(--ease), color .15s var(--ease);
}
.nav-item:hover{background:var(--accent-soft);color:var(--accent)}
.nav-item:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
.nav-item.active{background:var(--accent-soft-2);color:var(--accent);font-weight:600}
.nav-item-code{
  flex-shrink:0;min-width:38px;
  font-size:11px;font-weight:700;color:var(--fg-3);
  font-variant-numeric:tabular-nums;
}
.nav-item.active .nav-item-code{color:var(--accent)}
.nav-item-label{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* 待上线：只做进度提示，不可点 */
.nav-group-pending .nav-group-title{color:var(--fg-3)}
.nav-pending-row{
  display:flex;align-items:center;gap:9px;
  padding:4px 10px;font-size:12.5px;color:var(--fg-3);
}
.nav-pending-row + .nav-pending-row{border-top:1px dashed var(--line)}
.nav-pending-ch{flex-shrink:0;min-width:104px;font-weight:600}
.nav-pending-name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.nav-pending-w{flex-shrink:0;font-size:11px;opacity:.8}

.nav-foot{
  display:flex;align-items:center;justify-content:space-between;gap:10px;
  padding:8px 12px;border-top:1px solid var(--line);
  background:var(--bg);
  font-size:11.5px;color:var(--fg-3);
}
.nav-foot-nav{display:inline-flex;gap:6px}
.nav-step{
  padding:4px 10px;border-radius:999px;
  border:1px solid var(--line);
  color:var(--fg-2);text-decoration:none;font-size:12px;
  transition:border-color .15s var(--ease), color .15s var(--ease);
}
.nav-step:hover{border-color:var(--accent);color:var(--accent)}
.nav-step.is-off{opacity:.4;pointer-events:none}

@media(max-width:860px){
  .nav-trigger{max-width:52vw;padding:5px 10px 5px 6px}
  .nav-trigger-label{font-size:12.5px}
  .nav-panel{width:min(92vw,360px)}
  .nav-foot-tip{display:none}
}
@media(max-width:760px){
  /* 手机上再收一档：只留「章号 + 短标题」，保证顶栏单行不换行 */
  .topbar{gap:8px;padding:8px 12px}
  .nav-trigger-code{padding:2px 6px;font-size:11px}
  .nav-caret{display:none}
  .nav-pending-ch{min-width:88px}

  /* ⚠️ 窄屏必须把面板改成「贴顶栏左右边缘」，不能继续以 .nav 为锚点右对齐：
     .nav 右边还有「专注 / ⋯」按钮，面板向左溢出会有一部分跑到屏幕外。
     做法：.nav 退回 static（面板的包含块变回 position:sticky 的 .topbar），
     再用 left/right 撑满。不能用 position:fixed —— .topbar 有 backdrop-filter，
     会成为 fixed 的包含块，坐标会错位。 */
  .nav{position:static}
  .nav-panel{
    left:8px;right:8px;width:auto;
    top:calc(100% + 6px);
    max-height:calc(100vh - 84px);
  }
}

/* 主题切换按钮组 */
.theme-switch{
  display:flex;gap:2px;padding:3px;
  background:var(--bg-alt);border-radius:var(--radius-sm);
  border:1px solid var(--line);
  flex-shrink:0;
}
.theme-btn{
  border:none;background:transparent;cursor:pointer;
  padding:4px 9px;border-radius:5px;
  font-size:11.5px;font-family:inherit;color:var(--fg-3);
  transition:all .18s var(--ease);
}
.theme-btn:hover{color:var(--fg-2)}
.theme-btn.active{background:var(--bg-card);color:var(--accent);font-weight:600;box-shadow:var(--shadow-1)}

/* ---------- 5. 页面布局 ---------- */
.shell{
  display:flex;gap:var(--gap);
  max-width:var(--maxw);margin:0 auto;
  padding:0 var(--pad-x);
  align-items:flex-start;
}
.main{flex:1;min-width:0;padding:52px 0 100px}

/* 侧边目录 */
.toc{
  position:sticky;top:78px;
  width:var(--toc-w);flex-shrink:0;
  padding:52px 0 40px;
  font-size:13px;
  max-height:calc(100vh - 100px);
  overflow-y:auto;
  scrollbar-width:thin;
}
.toc-title{
  font-size:11px;font-weight:700;letter-spacing:.6px;
  text-transform:uppercase;color:var(--fg-3);
  margin-bottom:12px;padding-left:11px;
  display:flex;align-items:center;gap:8px;
}
/* 目录标题右侧加一条渐隐细线，视觉上把目录框住 */
.toc-title::after{
  content:'';flex:1;height:1px;
  background:linear-gradient(90deg,var(--line) 0%,transparent 100%);
}
.toc-item{
  display:block;padding:5px 11px;margin:1px 0;
  color:var(--fg-2);text-decoration:none;
  border-left:2px solid transparent;
  border-radius:0 var(--radius-sm) var(--radius-sm) 0;
  transition:all .18s var(--ease);
  line-height:1.5;
}
.toc-item:hover{color:var(--accent);background:var(--accent-soft)}
.toc-item.active{
  color:var(--accent);border-left-color:var(--accent);
  background:linear-gradient(90deg,var(--accent-soft) 0%,transparent 100%);
  font-weight:600;
}

/* ---------- 6. 封面（首页） ---------- */
.cover{
  padding:76px 0 60px;
  text-align:center;
  border-bottom:1px solid var(--line);
  margin-bottom:56px;
}
.cover-badge{
  display:inline-flex;align-items:center;gap:8px;
  padding:6px 16px;margin-bottom:28px;
  background:var(--accent-soft);border:1px solid var(--accent-soft-2);
  border-radius:100px;
  font-size:12.5px;color:var(--accent);font-weight:600;
}
.cover h1{
  font-size:3.5em;font-weight:800;letter-spacing:-1.6px;
  color:var(--accent);line-height:1.14;margin-bottom:16px;
}
/* ⚠️ 封面 h1 也继承 `.main h1::after` 那道 56px 短横线，但它是 display:block 的
   固定宽块级元素 —— 文字居中不代表块级元素居中，会贴到左边。
   修法：给封面这条短横线加 margin-left/right:auto 让它真正居中。 */
.cover h1::after{
  margin-left:auto;margin-right:auto;
  width:72px;height:3px;
}
.cover .sub{
  font-size:1.2em;color:var(--fg-2);
  margin-bottom:32px;max-width:620px;
  margin-left:auto;margin-right:auto;line-height:1.75;
}
.cover-stats{
  display:flex;justify-content:center;gap:14px;flex-wrap:wrap;
  margin-bottom:36px;
}
/* 数据卡：之前是"白框+黑字"，质感很弱。
   改成微渐变底 + 顶部一道主色细线 + 更深的投影，卡片有了"浮起来"的层次。 */
.stat{
  position:relative;
  background:linear-gradient(180deg,var(--bg-card) 0%,var(--bg-alt) 100%);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:14px 22px 13px;
  min-width:104px;
  box-shadow:var(--shadow-2);
  overflow:hidden;
}
.stat::before{
  content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,var(--accent) 0%,var(--accent-3) 100%);
}
.stat-num{
  display:block;font-size:2.05em;font-weight:700;
  color:var(--accent);line-height:1.14;letter-spacing:-.6px;
}
.stat-num small{font-size:.5em;font-weight:600;color:var(--fg-3);margin-left:1px}
.stat-label{display:block;font-size:11.5px;color:var(--fg-3);margin-top:4px;letter-spacing:.3px}

/* CTA 按钮 */
.cta-row{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}
.cta{
  display:inline-flex;align-items:center;gap:7px;
  padding:11px 24px;border-radius:var(--radius);
  font-size:14px;font-weight:600;text-decoration:none;
  border:1px solid var(--accent);background:var(--accent);color:var(--fg-inv);
  transition:all .2s var(--ease);
  box-shadow:var(--shadow-1);
}
.cta:hover{transform:translateY(-1px);box-shadow:var(--shadow-2);background:var(--accent-2)}
.cta-ghost{background:transparent;color:var(--accent);border-color:var(--line-2)}
.cta-ghost:hover{background:var(--accent-soft);border-color:var(--accent)}

/* ---------- 7. 标题与正文 ---------- */
h1{
  font-size:2.3em;font-weight:750;letter-spacing:-.6px;
  margin:1.5em 0 .55em;line-height:1.26;
}
h2{
  font-size:1.72em;font-weight:700;letter-spacing:-.3px;
  margin:2em 0 .5em;line-height:1.32;
  padding-bottom:.4em;border-bottom:1.5px solid var(--line);
}
h3{font-size:1.3em;font-weight:650;margin:1.8em 0 .42em;line-height:1.42}
h4{font-size:1.08em;font-weight:650;margin:1.5em 0 .35em}
h1:first-child,h2:first-child,h3:first-child,h4:first-child{margin-top:0}

p{margin:.95em 0}
p:first-child{margin-top:0}

strong{color:var(--accent);font-weight:650}
em{font-style:italic}

a{
  color:var(--accent);
  border-bottom:1px solid var(--accent-soft-2);
  text-decoration:none;
  transition:border-color .18s var(--ease), color .18s var(--ease);
}
a:hover{border-bottom-color:var(--accent-2)}

/* ---------- 8. 列表 ---------- */
ul,ol{margin:.85em 0 .85em 1.5em;padding:0}
li{margin:.32em 0;line-height:1.8}
li::marker{color:var(--fg-3)}
ul{list-style:none}
ul>li{position:relative}
ul>li::before{
  content:'';position:absolute;left:-1.1em;top:.78em;
  width:5px;height:5px;border-radius:50%;
  background:var(--accent-2);opacity:.75;
}
ol{list-style:decimal}
ol>li::marker{color:var(--accent-2);font-weight:600;font-size:.92em}

ul ul,ol ol,ul ol,ol ul{margin:.3em 0 .3em .2em}

/* ---------- 9. 表格 ---------- */
table{
  width:100%;border-collapse:separate;border-spacing:0;
  margin:1.5em 0;font-size:14.5px;
  border:1px solid var(--line);
  border-radius:var(--radius);
  overflow:hidden;
  box-shadow:var(--shadow-1);
}
th{
  background:linear-gradient(180deg,var(--bg-alt) 0%,var(--bg-deep) 100%);
  font-weight:700;font-size:12px;
  text-align:left;letter-spacing:.5px;
  padding:.78em 1em;
  border-bottom:1.5px solid var(--line-2);
  color:var(--accent);white-space:nowrap;
}
td{
  padding:.78em 1em;
  border-bottom:1px solid var(--line);
  line-height:1.7;
}
tr:last-child td{border-bottom:none}
tbody tr{transition:background .15s var(--ease)}
tbody tr:hover{background:var(--accent-soft)}
td strong{color:var(--accent)}

/* 数字/居中列 */
td[align="center"],th[align="center"]{text-align:center}

/* ---------- 10. 提示框 ----------
   优化要点：之前四种提示框各自带**整块饱和底色**，一页里绿/黄/紫连续堆叠，
   看起来像表单而不是书。改成「统一米白底 + 左侧粗色条 + 标题着色」，
   靠色条而不是靠大色块区分，页面立刻安静下来。 */
.block{
  position:relative;
  margin:1.6em 0;
  padding:1.05em 1.3em 1.1em 1.4em;
  border-radius:var(--radius);
  font-size:14.8px;line-height:1.78;
  border:1px solid var(--line);
  border-left:none;
  background:var(--bg-card);
  box-shadow:var(--shadow-1);
}
.block::before{
  content:'';position:absolute;left:0;top:10px;bottom:10px;
  width:4px;border-radius:0 4px 4px 0;
  background:var(--accent-2);
}
.block-title{
  font-weight:700;font-size:11.5px;
  letter-spacing:.7px;
  margin-bottom:7px;
  display:flex;align-items:center;gap:6px;
  color:var(--accent);
}
/* 每类只保留「标题色 + 色条色」，底色统一由 .block 提供 */
.warning::before{background:var(--warn-line)}
.warning .block-title{color:var(--warn-fg)}
.tip::before{background:var(--tip-line)}
.tip .block-title{color:var(--tip)}
.info::before{background:var(--accent-2)}
.info .block-title{color:var(--accent)}
.danger::before{background:var(--danger-line)}
.danger .block-title{color:var(--danger)}
.gold::before{background:var(--gold)}
.gold .block-title{color:var(--gold)}
.mem::before{background:var(--mem-line)}
.mem .block-title{color:var(--mem)}
.block p{margin:.55em 0}
.block p:last-child{margin-bottom:0}
.block ul{margin:.5em 0}
.block strong{color:inherit;font-weight:700}
.block{color:var(--fg-2)}
.warning{color:var(--warn-fg)}
.tip{color:var(--tip-fg)}
.mem{color:var(--mem-fg)}
.gold{color:var(--fg)}

/* ---------- 11. 引用（记忆点/口诀） ---------- */
.quote{
  margin:1.4em 0;
  padding:1em 1.3em 1em 1.5em;
  background:var(--bg-alt);
  border-radius:var(--radius);
  border:1px solid var(--line);
  font-size:15px;line-height:1.82;
  position:relative;
}
.quote:before{
  content:'';position:absolute;left:0;top:.9em;bottom:.9em;
  width:3px;border-radius:2px;background:var(--accent-2);
}
.quote p{margin:.35em 0}
.quote strong{color:var(--accent)}

/* ---------- 12. 表格内 mermaid / 代码 ---------- */
.mermaid-wrap{
  margin:1.7em 0;
  padding:22px 18px;
  background:var(--bg-card);
  border:1px solid var(--line);
  border-radius:var(--radius-lg);
  text-align:center;
  overflow-x:auto;
  box-shadow:var(--shadow-1);
}
.mermaid-wrap svg{max-width:100%;height:auto;display:block;margin:0 auto}
.mermaid-wrap.mermaid-err{
  text-align:left;font-size:13px;color:var(--danger);
  background:var(--danger-bg);border-color:var(--danger-line);
}

pre{
  margin:1.3em 0;
  padding:1em 1.2em;
  background:var(--bg-deep);
  border:1px solid var(--line);
  border-radius:var(--radius);
  font-family:var(--mono);
  font-size:13px;line-height:1.68;
  overflow-x:auto;
  color:var(--fg-2);
}

/* ---------- 13. Quiz 答题模块 ---------- */
.quiz{
  margin:2.6em 0;
  background:var(--bg-card);
  border:1.5px solid var(--line-2);
  border-radius:var(--radius-lg);
  overflow:hidden;
  box-shadow:var(--shadow-2);
}
.quiz-head{
  display:flex;align-items:center;gap:14px;flex-wrap:wrap;
  padding:15px 22px;
  background:var(--bg-alt);
  border-bottom:1.5px solid var(--line);
}
.quiz-label{
  font-weight:700;font-size:14px;color:var(--accent);
  display:flex;align-items:center;gap:7px;
}
.quiz-progress{
  font-size:12.5px;color:var(--fg-3);flex:1;min-width:120px;
}
.quiz-progress b{color:var(--accent);font-weight:700}
.quiz-pbar{
  height:4px;background:var(--line);border-radius:3px;
  width:100%;margin-top:10px;overflow:hidden;
}
.quiz-pbar-fill{
  height:100%;background:var(--accent-2);
  transform-origin:left;width:0;
  transition:width .35s var(--ease);
}
.quiz-btn{
  font-size:12px;padding:5px 12px;
  border:1px solid var(--line-2);background:var(--bg-card);
  color:var(--fg-2);border-radius:var(--radius-sm);
  cursor:pointer;font-family:inherit;
  transition:all .18s var(--ease);
  white-space:nowrap;
}
.quiz-btn:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-soft)}
.quiz-btn:active{transform:scale(.97)}

/* 题目卡 */
.quiz-item{
  padding:20px 24px;
  border-bottom:1px solid var(--line);
  transition:background .25s var(--ease);
}
.quiz-item:last-child{border-bottom:none}
.quiz-q{
  font-size:15px;font-weight:600;line-height:1.72;
  margin-bottom:14px;
}
.quiz-q .qn{
  display:inline-flex;align-items:center;justify-content:center;
  width:22px;height:22px;border-radius:6px;
  background:var(--accent-soft);color:var(--accent);
  font-size:12px;font-weight:700;margin-right:8px;
  vertical-align:1px;
}
.opts{display:flex;flex-direction:column;gap:8px}
.opt{
  display:flex;align-items:flex-start;gap:11px;
  padding:11px 15px;
  border:1.5px solid var(--line);
  border-radius:var(--radius);
  cursor:pointer;font-size:14.5px;line-height:1.68;
  transition:all .2s var(--ease);
  user-select:none;
}
.opt:hover{border-color:var(--accent-2);background:var(--accent-soft);transform:translateX(3px)}
.opt .letter{
  flex:0 0 21px;height:21px;
  border-radius:5px;
  background:var(--bg-alt);border:1px solid var(--line-2);
  display:flex;align-items:center;justify-content:center;
  font-size:11px;font-weight:700;color:var(--fg-3);
  margin-top:2px;
}
.opt .txt{flex:1;min-width:0}
.opt.picked{border-color:var(--accent);background:var(--accent-soft-2)}
.opt.right{border-color:var(--tip-line);background:var(--tip-bg);font-weight:600}
.opt.right .letter{background:var(--tip-line);color:#fff;border-color:var(--tip-line)}
.opt.wrong-pick .letter{background:var(--danger-line);color:#fff;border-color:var(--danger-line)}
.mark{font-weight:700;margin-left:auto;font-size:15px;flex-shrink:0}
.mark.ok{color:var(--tip-line)}
.mark.no{color:var(--danger-line)}

.quiz-item.correct{background:var(--tip-bg)}
.quiz-item.wrong{background:var(--danger-bg)}

/* 解析区 */
.reveal{
  margin-top:16px;padding-top:16px;
  border-top:1px dashed var(--line-2);
  animation:fadeUp .3s var(--ease);
}
@keyframes fadeUp{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}
.reveal-verdict{
  font-weight:700;font-size:14.5px;margin-bottom:9px;
  display:flex;align-items:center;gap:10px;
}
.reveal-verdict .answer{
  font-weight:500;font-size:13px;color:var(--fg-2);
  background:var(--bg-alt);padding:2px 10px;border-radius:5px;
}
.reveal-explain{
  font-size:14px;color:var(--fg-2);line-height:1.82;
}
.reveal-ref{
  font-size:12.5px;color:var(--fg-3);
  margin-top:8px;font-style:italic;
}

/* ---------- 14. 错题本 ---------- */
.wrongbook{
  margin:2.6em 0;
  background:var(--bg-card);
  border:1.5px solid var(--line-2);
  border-radius:var(--radius-lg);
  overflow:hidden;
  box-shadow:var(--shadow-1);
}
.wb-head{
  display:flex;align-items:center;gap:14px;flex-wrap:wrap;
  padding:15px 22px;
  background:var(--bg-alt);
  border-bottom:1.5px solid var(--line);
  font-weight:700;font-size:14px;color:var(--accent);
}
.wb-total{font-size:12.5px;color:var(--fg-3);font-weight:400;margin-left:auto}
.wb-empty{
  padding:26px 22px;text-align:center;
  font-size:13.5px;color:var(--fg-3);
}
.wb-row{
  display:flex;align-items:center;gap:14px;
  padding:12px 22px;
  border-bottom:1px solid var(--line);
  transition:background .15s var(--ease);
}
.wb-row:hover{background:var(--accent-soft)}
.wb-row a{font-size:14px;color:var(--accent);font-weight:600}
.wb-row a:hover{background:none;border-bottom-color:var(--accent)}
.wb-count{
  font-size:12px;color:var(--fg-3);
  background:var(--bg-alt);padding:3px 10px;border-radius:5px;
  margin-left:auto;
}
.wb-clear{
  width:100%;padding:11px;
  border:none;background:transparent;
  color:var(--fg-3);font-size:12.5px;cursor:pointer;
  font-family:inherit;
  transition:all .18s var(--ease);
}
.wb-clear:hover{background:var(--danger-bg);color:var(--danger)}

/* ---------- 15. 页脚 ---------- */
.footer{
  margin-top:70px;
  padding:36px 28px 44px;
  text-align:center;
  border-top:1px solid var(--line);
  font-size:12.5px;color:var(--fg-3);
}
.footer p{margin:.4em 0}
.footer strong{color:var(--fg-2);font-weight:600}
.footer .sep{margin:.9em 0;font-size:11.5px}

/* ---------- 16. 快捷键面板 ---------- */
.keyhint{
  margin:2.4em 0;
  padding:16px 20px;
  background:var(--bg-alt);
  border:1px solid var(--line);
  border-radius:var(--radius);
  font-size:13px;color:var(--fg-2);
  display:flex;flex-wrap:wrap;gap:8px 22px;align-items:center;
}
.keyhint-title{font-weight:700;color:var(--accent);font-size:12.5px}
.kbd{
  display:inline-flex;align-items:center;justify-content:center;
  key-order:0;
  min-width:22px;height:22px;padding:0 6px;
  background:var(--bg-card);border:1px solid var(--line-2);
  border-bottom-width:2px;
  border-radius:5px;
  font-family:var(--mono);font-size:11px;
  font-weight:600;color:var(--fg-2);
}
.keyhint span.item{display:flex;align-items:center;gap:6px}

/* ---------- 17. 响应式 ---------- */
@media(max-width:1240px){
  /* 目录还在，但正文让出宽度给两侧留白 */
  .shell{max-width:1000px;gap:40px;--pad-x:28px}
  .toc{width:200px}
}
@media(max-width:1100px){
  .shell{max-width:820px;gap:0;--pad-x:24px}
  .toc{display:none}
}
@media(max-width:760px){
  body{font-size:16px;line-height:1.82}
  .topbar{height:auto;min-height:52px;padding:10px 16px;flex-wrap:wrap;gap:10px}
  .brand-sub{display:none}
  /* 窄屏：品牌只留图标，标题在触发器里显示，顶栏保持单行 */
  .brand span:not(.brand-mark){display:none}
  .nav{margin-left:auto;gap:2px}
  .main{padding:32px 0 80px}
  .cover{padding:48px 0 40px;margin-bottom:40px}
  .cover h1{font-size:2.4em;letter-spacing:-.8px}
  .cover .sub{font-size:1.05em;margin-bottom:24px}
  .cover-stats{gap:10px;margin-bottom:28px}
  .stat{min-width:76px;padding:10px 14px}
  .stat-num{font-size:1.5em}
  h1{font-size:1.85em;margin:1.4em 0 .5em}
  h2{font-size:1.5em;margin:1.8em 0 .45em}
  h3{font-size:1.18em}
  table{font-size:13.5px}
  th{padding:.6em .8em;white-space:normal}
  td{padding:.68em .8em}
  .quiz-item{padding:16px 18px}
  .quiz-q{font-size:14.5px}
  .opt{padding:10px 13px;font-size:14px}
  .mermaid-wrap{padding:16px 12px}
  .footer{margin-top:50px;padding:28px 16px 36px}
}
@media(max-width:480px){
  .theme-switch{display:inline-flex}  /* 极窄屏仍需主题切换（深浅色刚需），依赖⋯浮层收纳 */
}

/* ---------- 18. 打印样式 ---------- */
@media print{
  .read-progress,
  .topbar,
  .toc,
  .theme-switch,
  .quiz-btn,
  .cta-row,
  .wrongbook,
  .keyhint,
  .pager,
  .focus-btn,
  .search-panel,
  .search-box,
  .search-results,
  .mermaid-wrap .lang{
    display:none !important;
  }

  body{
    font-size:11pt;
    line-height:1.62;
    background:#fff;
    color:#000;
  }
  .shell{max-width:100%;padding:0;gap:0}
  .main{padding:0}

  h1{font-size:19pt;margin:1.2em 0 .4em}
  h2{font-size:15pt;margin:1.5em 0 .4em}
  h3{font-size:12.5pt}
  h4{font-size:11pt}
  h1,h2,h3,h4{break-after:avoid;page-break-after:avoid}

  .cover{padding:0 0 18px;margin-bottom:18px;text-align:left}
  .cover h1{font-size:24pt}
  .cover-stats,.cover-badge,.cta-row{display:none !important}

  a[href^="http"]:after{
    content:" (" attr(href) ")";
    font-size:8pt;color:#666;word-break:break-all;
  }

  table{
    font-size:9.5pt;margin:1em 0;
    box-shadow:none;border:1px solid #ccc;
  }
  th{background:#f0f0f0 !important;color:#000 !important}
  th,td{padding:.5em .7em}
  thead{display:table-header-group}
  tr{break-inside:avoid;page-break-inside:avoid}

  .quiz-item{
    break-inside:avoid;
    page-break-inside:avoid;
    background:#fff !important;
  }
  .quiz{border:1px solid #ccc;box-shadow:none}
  .quiz-head{background:#f6f6f6 !important}

  .block,.quote,.mermaid-wrap{
    break-inside:avoid;
    page-break-inside:avoid;
  }
  .mermaid-wrap svg{max-height:220mm;height:auto}

  strong{color:#000 !important}
  .footer{page-break-before:always;margin-top:0;padding-top:20px}
}

/* ---------- 19. 上下页导航 ---------- */
.pager{
  display:flex;gap:14px;
  margin:44px 0 0;
}
.pg{
  flex:1;min-width:0;
  display:flex;flex-direction:column;gap:3px;
  padding:15px 18px;
  background:var(--bg-card);
  border:1.5px solid var(--line);
  border-radius:var(--radius);
  text-decoration:none;
  transition:all .2s var(--ease);
}
.pg:hover{
  border-color:var(--accent-2);
  background:var(--accent-soft);
  transform:translateY(-2px);
  box-shadow:var(--shadow-2);
}
.pg-label{
  font-size:11.5px;letter-spacing:.5px;
  color:var(--fg-3);font-weight:600;
  text-transform:uppercase;
}
.pg-title{
  font-size:14.5px;font-weight:650;color:var(--accent);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.pg-next{text-align:right}
.pg-next .pg-label::after{content:""}
@media(max-width:640px){
  .pager{flex-direction:column;gap:10px}
  .pg-next{text-align:left}
}

/* ---------- 20. mermaid 降级提示 ---------- */
.mmd-note{
  font-size:12px;font-weight:600;letter-spacing:.4px;
  color:var(--danger);margin-bottom:8px;
  display:flex;align-items:center;gap:6px;
}
.mmd-note::before{
  content:'';width:7px;height:7px;border-radius:50%;
  background:var(--danger);flex:0 0 auto;
}
.mermaid-wrap.mermaid-err pre{
  margin:0;text-align:left;
  font-size:12px;max-height:340px;overflow:auto;
}

/* ---------- 21. 移动端表格横向滚动 ---------- */
@media(max-width:760px){
  .vp-doc table,
  main table{
    display:block;
    overflow-x:auto;
    -webkit-overflow-scrolling:touch;
    max-width:100%;
  }
  main table tbody{min-width:520px}
  /* 让表头保持可读 */
  main th{white-space:nowrap}
}

/* mermaid 源码占位（未渲染前隐藏；源码在 data-src 属性里） */
.vp-doc .mermaid-src,
main .mermaid-src{ display:none !important }

/* ---------- 22. 多级目录（4 级） ---------- */
.toc{ font-size:12.5px }
.toc-tree{ margin-top:2px }
.toc-item{
  display:block;
  padding:3.5px 10px 3.5px calc(11px + var(--depth,0) * 13px);
  margin:0;
  border-left:2px solid transparent;
  border-radius:0 5px 5px 0;
  line-height:1.45;
  color:var(--fg-3);
  position:relative;
  transition:color .15s var(--ease), background .15s var(--ease), border-color .15s var(--ease);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
/* 层级视觉：h2 加粗深色，h3/h4/h5 逐级变浅变小 */
.toc-l1{ font-weight:650;font-size:13px;color:var(--fg-2);margin-top:8px }
.toc-l1:first-child{ margin-top:0 }
.toc-l2{ font-weight:500 }
.toc-l3{ padding-left:calc(11px + var(--depth,0)*13px); font-size:12px }
.toc-l4{ font-size:11.5px;opacity:.9 }
/* 子级左侧引导线 */
.toc-item[style*="--depth:1"]::before,
.toc-item[style*="--depth:2"]::before,
.toc-item[style*="--depth:3"]::before{
  content:'';position:absolute;left:calc(4px + (var(--depth) - 1) * 13px);
  top:0;bottom:0;width:1px;background:var(--line);
}
.toc-item:hover{ color:var(--accent);background:var(--accent-soft) }
.toc-item.active{
  color:var(--accent);font-weight:600;
  background:var(--accent-soft);
  border-left-color:var(--accent);
}
.toc-item.active.toc-l2,
.toc-item.active.toc-l3,
.toc-item.active.toc-l4{ background:var(--accent-soft-2) }

/* 目录项过多时滚动 */
.toc{ max-height:calc(100vh - 110px);overflow-y:auto;overscroll-behavior:contain }
.toc::-webkit-scrollbar{width:4px }
.toc::-webkit-scrollbar-thumb{background:var(--line-2);border-radius:4px }

/* 折叠按钮（只在有子节点时显示） */
.toc-toggle{
  position:absolute;left:0;top:0;width:16px;height:100%;
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;color:var(--fg-3);
}
.toc-toggle::before{
  content:'';width:0;height:0;
  border-left:4px solid currentColor;
  border-top:3.5px solid transparent;
  border-bottom:3.5px solid transparent;
  transition:transform .18s var(--ease);
}
.toc-group.collapsed > .toc-toggle::before{ transform:rotate(-90deg) }
.toc-group.collapsed > .toc-sub{ display:none }

@media(max-width:1100px){ .toc{ display:none } }

/* ---------- 23. 专注模式 ---------- */
/* 注意：不要用 visibility:hidden 兜底 —— 那会把退出按钮一起隐藏，真人点不到。
   正确做法见文件末尾「专注模式退出按钮修复」段（opacity + pointer-events）。 */
html.focus-mode .shell{
  max-width:720px;
  margin:0 auto;
  padding:40px 24px 80px;
}
/* 顶栏里的专注按钮常态样式 */
.focus-btn{
  background:var(--bg-card);border:1px solid var(--line);
  border-radius:999px;padding:5px 12px;
  font-size:12px;font-weight:600;color:var(--fg-3);
  cursor:pointer;transition:all .18s var(--ease);
  display:inline-flex;align-items:center;gap:5px;
}
.focus-btn::before{ content:'◐'; font-size:11px;opacity:.7 }
.focus-btn:hover{ color:var(--accent);border-color:var(--accent);background:var(--accent-soft) }
.focus-btn.active{ color:#fff;background:var(--accent);border-color:var(--accent) }
.focus-btn.active::before{ opacity:1 }

/* ---------- 24. 全文搜索面板 ---------- */
.search-panel{
  position:fixed;inset:0;z-index:80;
  display:none;
  background:rgba(0,0,0,.28);
  backdrop-filter:blur(3px);
}
.search-panel.open{ display:block }
.search-box{
  position:absolute;top:12%;left:50%;transform:translateX(-50%);
  width:min(640px,90vw);
  background:var(--bg-card);
  border:1.5px solid var(--line);
  border-radius:var(--radius);
  box-shadow:var(--shadow-3,0 20px 60px rgba(0,0,0,.25));
  padding:14px 18px;
  display:flex;align-items:center;gap:12px;
}
.search-input{
  flex:1;border:none;background:transparent;outline:none;
  font-size:16px;font-family:var(--font);color:var(--fg);
}
.search-input::placeholder{ color:var(--fg-3) }
.search-count{
  font-size:11.5px;color:var(--fg-3);white-space:nowrap;
  font-variant-numeric:tabular-nums;
}
.search-results{
  position:absolute;top:calc(12% + 76px);left:50%;transform:translateX(-50%);
  width:min(640px,90vw);
  max-height:52vh;overflow:auto;
  background:var(--bg-card);
  border:1.5px solid var(--line);border-top:none;
  border-radius:0 0 var(--radius) var(--radius);
  box-shadow:var(--shadow-3,0 20px 60px rgba(0,0,0,.25));
  list-style:none;margin:0;padding:6px;
}
.search-results:empty{ display:none }
.search-hit{
  display:flex;gap:10px;align-items:baseline;
  padding:9px 12px;border-radius:6px;cursor:pointer;
  font-size:13px;line-height:1.5;
}
.search-hit:hover{ background:var(--bg-soft) }
.search-hit.cur{ background:var(--accent-soft) }
.hit-kind{
  flex:0 0 auto;
  font-size:10.5px;font-weight:700;letter-spacing:.4px;
  padding:2px 7px;border-radius:4px;
  background:var(--accent-soft);color:var(--accent);
}
.hit-kind:has(+ .hit-text:has(mark)){ }
.hit-text{ color:var(--fg-2);flex:1;min-width:0 }
mark.search-mark{
  background:rgba(255,196,0,.4);
  color:inherit;border-radius:3px;padding:0 2px;
  box-shadow:0 0 0 2px rgba(255,196,0,.25);
}
html[data-theme="dark"] mark.search-mark{
  background:rgba(255,196,0,.28)
}
.flash-hit{
  animation:flashHit 1.1s var(--ease);
}
@keyframes flashHit{
  0%{ background:rgba(255,196,0,.35) }
  100%{ background:transparent }
}

/* ---------- 25. 快捷键提示更新（含 / 与 F） ---------- */
/* 字号调节无 UI，仅键盘 - / + */

/* ═══════════════════════════════════════════════════════════════
   ��五版 · 出版物排版（A 方案）
   改动目标：换掉"技术文档站"气质，走教材/杂志的阅读质感
   关键约束：全部用系统字体，零外部请求 → 部署后与本地完全一致
   ═══════════════════════════════════════════════════════════════ */

/* ── 1. 正文排版：衬线标题 + 更合适的行宽与行距 ── */
/* 合并到顶部 :root（避免重复定义导致后者覆盖前者） */

.main{ max-width:var(--measure) }
.main p{
  font-family:var(--sans);
  font-size:1.02em;
  line-height:1.95;
  letter-spacing:.01em;
  color:var(--fg);
  margin:1.15em 0;
  text-align:justify;          /* 两端对齐，中文排版更整齐 */
  text-justify:inter-ideograph;
}

/* ⚠️ 全局断行保护（H35 踩坑后补）：
   正文里常出现"无空格长串"（如 HTTP 状态码 `200/301/302/400/...`、
   长 URL、驼峰标识符），浏览器默认**不会在斜杠/点号处断行**，
   这类串在 375px 窄屏会把文档撑宽并产生横向滚动（实测溢出 27px）。
   `overflow-wrap:anywhere` 只在"单词本身放不下"时才断，
   不影响中英文正常排版 —— 比 `word-break:break-all` 安全得多
   （后者会在任意字符处断，中文正文会被切得很难看）。 */
.main{
  overflow-wrap:anywhere;
}
.main p, .main li, .main td, .main th, .main strong, .main em, .main code{
  overflow-wrap:anywhere;
}
.main a{ overflow-wrap:anywhere }

/* ── 2. 标题：衬线体 + 短横线，替代通栏分割线 ── */
/* ---------- 章首进度条（22 章 × 每章几十节时的定位锚）----------
   ⚠️ sticky top 必须 = 顶栏实际高度。顶栏是 `position:sticky; height:54px`，
   这里写小了会被顶栏盖住（截图里只剩进度条贴着顶栏下沿、"9 / 20" 灰在下面）。
   宽度也留出顶栏投影的落点，避免滚动时内容从下方"顶穿"。 */
.chapbar{
  position:sticky;top:53px;z-index:110;
  margin:0 0 34px;
  padding:11px 0 10px;
  background:linear-gradient(180deg,var(--bg) 74%,transparent);
  backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
}
.chapbar-top{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.chapbar-badge{
  flex-shrink:0;
  padding:2px 9px;border-radius:999px;
  background:var(--accent);color:var(--fg-inv);
  font-size:11.5px;font-weight:700;letter-spacing:.02em;
}
.chapbar-title{
  font-size:13px;color:var(--fg-2);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.chapbar-spacer{flex:1}
.chapbar-sec{
  flex-shrink:0;
  font-size:12px;color:var(--fg-3);
  font-variant-numeric:tabular-nums;
}
.chapbar-track{
  height:3px;border-radius:2px;
  background:var(--bg-deep);overflow:hidden;
}
.chapbar-fill{
  height:100%;width:0;border-radius:2px;
  background:linear-gradient(90deg,var(--accent) 0%,var(--accent-3) 100%);
  transition:width .18s var(--ease);
}
@media(max-width:760px){
  /* 窄屏顶栏实际高度是 57px（flex-wrap 后实测），这里跟着改 */
  .chapbar{top:56px;margin-bottom:26px;padding:10px 0 8px}
  .chapbar-title{display:none}
}
/* 专注模式：进度条是"定位锚"，保留但变淡 */
html.focus-mode .chapbar{opacity:.35;pointer-events:none}

.main h1,.main h2,.main h3,.main h4{
  font-family:var(--serif);
  font-weight:600;
  letter-spacing:.01em;
  color:var(--fg);
}
.main h1{
  font-size:2.15em;line-height:1.3;
  margin:.5em 0 .7em;           /* 页面顶部无大间距 */
  padding-bottom:0;             /* 去掉通栏 border */
  position:relative;
}
/* 章首横幅：h1 上方加一条"章号 + 主色渐变"的装饰带，
   让每页开头有一个明确的"进入新章"仪式感（原来 h1 直接浮在正文里）。
   ⚠️ 必须排除 .cover —— 封面 h1 自己已有顶部留白与居中布局，
   加上横幅会与下方分隔线叠成双线（首页曾出现两条横线紧挨）。 */
.main h1:not(.cover h1)::before{
  content:'';display:block;
  width:100%;height:4px;
  background:linear-gradient(90deg,var(--accent) 0%,var(--accent-3) 42%,transparent 88%);
  border-radius:2px;
  margin-bottom:.62em;
}
.cover h1::before{content:none}
.main h1::after{
  content:'';display:block;
  width:56px;height:3px;
  background:var(--accent);
  margin-top:.5em;              /* 短横线，比通栏线优雅 */
  border-radius:2px;
}
.main h2{
  font-size:1.62em;line-height:1.38;
  margin:2.2em 0 .62em;
  padding:0 0 .45em 0;
  border:0;
  position:relative;
}
/* h2 左侧加一道竖锚：强化"大章节"的层级感，替代原来那条渐变横线 */
.main h2::before{
  content:'';position:absolute;
  left:-18px;top:.34em;bottom:.5em;
  width:3px;border-radius:2px;
  background:linear-gradient(180deg,var(--accent) 0%,var(--accent-3) 100%);
  opacity:.75;
}
.main h2::after{
  content:'';position:absolute;
  left:0;bottom:0;width:100%;height:1px;
  background:linear-gradient(90deg,var(--line) 0%,var(--line) 26%,transparent 100%);
}
.main h3{
  font-size:1.26em;line-height:1.5;
  margin:1.9em 0 .5em;
}
.main h3::before{               /* h3 前缀小方块，建立视觉锚点 */
  content:'';display:inline-block;
  width:.46em;height:.46em;
  background:var(--accent-3);
  border-radius:2px;
  margin-right:.5em;
  vertical-align:.06em;
}
.main h4{
  font-size:1.06em;
  margin:1.6em 0 .4em;
  color:var(--fg-2);
}

/* 首段导语：h1 之后的第一段用稍大、稍淡的引言体，形成"开篇"感。
   用 :first-of-type 而不是 .lead —— 内容是 markdown 转出来的，
   h1 后面紧跟的通常是 blockquote 或提示框，不一定有 <p>。 */
.main h1 + p,
.main h1 + blockquote + p{
  font-size:1.06em;
  color:var(--fg-2);
  line-height:1.82;
}
/* 正文里的第一条列表：去掉与标题之间多余的视觉间隔 */
.main h2 + ul,.main h3 + ul,.main h2 + ol,.main h3 + ol{margin-top:.3em}

/* ── 3. 引用块：加深底 + 左侧色条（原来几乎不可见）── */
.main .quote{
  position:relative;
  margin:1.7em 0;
  padding:1.1em 1.4em 1.1em 1.5em;
  background:linear-gradient(135deg,var(--accent-soft) 0%,transparent 60%);
  border-left:3px solid var(--accent-2);
  border-radius:0 var(--radius) var(--radius) 0;
  font-family:var(--sans);
  font-size:.98em;
  line-height:1.9;
}
.main .quote::before{ content:none }     /* 覆盖旧的 ::before */
.main .quote p{ margin:.4em 0; text-align:left }
.main .quote strong{ color:var(--accent);font-weight:700 }

/* ── 4. 列表：改为方形标记 + 更松的间距 ── */
.main ul>li::before{
  content:'';position:absolute;
  left:-1.15em;top:.82em;
  width:5px;height:5px;
  background:var(--accent-3);
  border-radius:1px;              /* 方点，比圆点更书卷 */
  transform:rotate(45deg);        /* 菱形 */
  opacity:.85;
}
.main li{ margin:.42em 0 }
.main ol>li::marker{ color:var(--accent-2);font-weight:700;font-size:.9em }

/* ── 5. 表格：去掉阴影，改用衬线表头 + 更轻的分隔 ── */
.main table{
  box-shadow:none;
  border:0;
  border-top:2px solid var(--accent-2);
  border-bottom:1px solid var(--line-2);
  border-radius:0;
  margin:1.8em 0;
  font-family:var(--sans);
}
.main thead{ border-bottom:1px solid var(--line) }
.main th{
  background:transparent;
  font-family:var(--serif);
  font-weight:600;
  font-size:13px;
  color:var(--accent);
  letter-spacing:.04em;
  padding:.85em 1em;
  border-bottom:1px solid var(--line);
  text-transform:none;            /* 中文不需要uppercase */
}
.main td{
  padding:.85em 1em;
  border-bottom:1px solid var(--line);
  font-size:.96em;
}
.main tbody tr:last-child td{ border-bottom:none }
.main tbody tr:hover{ background:var(--accent-soft) }
.main td strong{ color:var(--accent);font-weight:700 }

/* ── 6. mermaid 容器：去掉边框阴影，改成"插图"质感 ── */
.main .mermaid-wrap{
  margin:2em 0;
  padding:1.6em 1em;
  background:var(--bg-alt);
  border:0;
  border-top:1px solid var(--line);
  border-bottom:1px solid var(--line);
  border-radius:0;
  box-shadow:none;
  text-align:center;
  overflow-x:auto;
}

/* ── 7. 提示框：左侧色条加粗 + 标题衬线体 ── */
.main .block{
  margin:1.7em 0;
  padding:1.05em 1.35em;
  border-radius:var(--radius);
  border:1px solid var(--line);
  /* ⚠️ 这里原来有 `border-left:3.5px solid` + `border-radius:0 R R 0`（左侧色条版式）。
     设计 v6 改成「左侧 4px 色条 = ::before 伪元素 + 四周圆角」后必须去掉这条：
     它是 2 个类（.main .block），比第 10 节的 .block（1 个类）优先级高，
     会把 ::before 色条往左挤 —— 表现为"色条贴在边框外侧"。
     顺带把 sans 补回变量名（下面 font-family:var(--sans) 引用了一个不存在的变量）。 */
  font-family:var(--font);
  font-size:.97em;
  line-height:1.85;
  background:var(--bg-card);
  box-shadow:var(--shadow-1);
}
.main .block-title{
  font-family:var(--serif);
  font-weight:600;
  font-size:12.5px;
  letter-spacing:.08em;
  text-transform:none;
  margin-bottom:.55em;
  display:flex;align-items:center;gap:.5em;
}
.main .block-title::before{ content:'';width:4px;height:4px;border-radius:50%;background:currentColor;flex:0 0 auto }
/* ⚠️ 这组覆盖已废弃：提示框改为「统一米白底 + 左侧色条」后，
   各类型只保留标题色与色条色（见第 10 节），不要再在这里给整块上底色。
   留着它们会让绿/黄/紫大色块重新回来，页面又变回表单样。 */
.main .block p{ margin:.5em 0 }

/* ── 8. Quiz 卡片（B 方案局部借用）：题块更立体 ── */
.main .quiz{
  margin:2.4em 0;
  border:0;
  border-top:2px solid var(--accent-2);
  border-radius:0;
  background:transparent;
  box-shadow:none;
  overflow:visible;
}
.main .quiz-head{
  background:var(--bg-alt);
  border:0;
  border-bottom:1px solid var(--line);
  border-radius:var(--radius) var(--radius) 0 0;
  padding:1em 1.3em;
}
.main .quiz-label{
  font-family:var(--serif);
  font-size:1.02em;
  font-weight:600;
  letter-spacing:.04em;
}
.main .quiz-item{
  background:var(--bg-card);
  border:1px solid var(--line);
  border-radius:var(--radius);
  margin-bottom:.9em;
  padding:1.35em 1.5em;
}
.main .quiz-item.correct{
  background:var(--tip-bg);
  border-color:var(--tip-line);
  border-left-width:3.5px;
}
.main .quiz-item.wrong{
  background:var(--danger-bg);
  border-color:var(--danger-line);
  border-left-width:3.5px;
}
.main .quiz-q{
  font-family:var(--serif);
  font-size:1.04em;
  font-weight:600;
  line-height:1.72;
  color:var(--fg);
}
.main .quiz-q .qn{
  background:var(--accent);color:var(--fg-inv);
  border-radius:3px;
  font-family:var(--sans);
  font-size:11.5px;
}
.main .opt{
  font-family:var(--sans);
  border-radius:var(--radius-sm);
  border-color:var(--line);
  background:var(--bg);
}
.main .opt:hover{ background:var(--accent-soft);border-color:var(--accent-2) }
.main .opt.right{ background:var(--tip-bg);border-color:var(--tip-line) }
.main .reveal-explain{ font-family:var(--sans);line-height:1.88 }
.main .reveal-ref{ font-style:normal;opacity:.75 }

/* ── 9. 上下页导航 / 错题本：与新风格对齐 ── */
.main .pg{
  background:var(--bg-card);
  border:1px solid var(--line);
  border-radius:var(--radius);
}
.main .pg-title{ font-family:var(--serif) }
.main .wrongbook{
  border:0;
  border-top:2px solid var(--danger-line);
  border-radius:0;
  background:transparent;
  box-shadow:none;
}
.main .wrongbook .wb-head{
  background:var(--danger-bg);
  border-bottom:1px solid var(--line);
  font-family:var(--serif);
  border-radius:var(--radius) var(--radius) 0 0;
}
.main .wb-row{ border-bottom:1px solid var(--line) }
.main .wb-row a{ font-family:var(--serif);font-weight:600 }

/* ── 10. 页脚：更像版权页 ── */
.main .footer{
  margin-top:3.5em;
  padding-top:2em;
  border-top:1px solid var(--line);
  font-size:12.5px;
}
.main .footer strong{ font-family:var(--serif);font-size:14px }

/* ═══════════════════════════════════════════════════════════════
   顶栏溢出菜单 + 目录层级强化
   ═══════════════════════════════════════════════════════════════ */

/* 顶栏：控件收进⋯ 浮层 */
.overflow-btn{
  background:var(--bg-card);
  border:1px solid var(--line);
  border-radius:999px;
  width:30px;height:30px;
  font-size:16px;line-height:1;
  color:var(--fg-3);cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:all .18s var(--ease);
  flex-shrink:0;
}
.overflow-btn:hover{ color:var(--accent);border-color:var(--accent-2) }
.overflow-btn.active{ color:#fff;background:var(--accent);border-color:var(--accent) }

.overflow-panel{
  position:absolute;top:calc(100% + 8px);right:28px;
  background:var(--bg-card);
  border:1.5px solid var(--line);
  border-radius:var(--radius);
  box-shadow:var(--shadow-2);
  padding:10px;
  display:none;
  z-index:120;
}
.overflow-panel.open{ display:block }
.overflow-panel .theme-switch{
  background:var(--bg-alt);
  border:1px solid var(--line);
  padding:3px;
  border-radius:var(--radius-sm);
  display:flex;gap:2px;
}
.overflow-panel .theme-btn{
  border:none;background:transparent;cursor:pointer;
  padding:5px 11px;border-radius:5px;
  font-size:12px;font-family:var(--serif);font-weight:600;
  color:var(--fg-3);transition:all .18s var(--ease);
}
.overflow-panel .theme-btn:hover{ color:var(--fg-2) }
.overflow-panel .theme-btn.active{
  background:var(--bg-card);color:var(--accent);
  box-shadow:var(--shadow-1);
}

/* 专注模式：顶栏只留一个圆钮 */
.focus-btn-top{ padding:5px 13px }
html.focus-mode .focus-btn-top{ display:inline-flex !important }
html.focus-mode .overflow-btn,
html.focus-mode .nav{ display:none }

/* 目录：加大缩进 + 层级色差，让4 级看得出来 */
.toc{ width:236px; font-size:12.5px }
.toc-item{
  padding:4px 10px 4px calc(12px + var(--depth,0) * 17px);
  line-height:1.5;
}
.toc-l1{
  font-family:var(--serif);
  font-size:13.5px;font-weight:600;
  color:var(--fg);
  margin-top:12px;
  padding-top:6px;
  border-top:1px solid var(--line);
}
.toc-l1:first-child{ margin-top:0;padding-top:0;border-top:none }
.toc-l2{ color:var(--fg-2);font-weight:500;margin-top:4px }
.toc-l3{ color:var(--fg-3);font-size:12px }
.toc-l4{ color:var(--fg-3);font-size:11.5px;opacity:.85 }
.toc-item:hover{ background:var(--accent-soft);color:var(--accent) }
.toc-item.active{
  color:var(--accent);
  font-weight:700;
  background:var(--accent-soft-2);
  border-left-color:var(--accent);
}
.toc-title{
  font-family:var(--serif);
  font-size:11.5px;letter-spacing:.1em;
  color:var(--fg-3);
  padding-bottom:.6em;
  border-bottom:1px solid var(--line);
  margin-bottom:.7em;
}

/* ── 11. 修h1 换行 + mermaid 节点间距 ── */
.main h1{
  font-size:1.95em;                 /* 略降，避免长标题折行 */
  text-wrap:balance;                /* 浏览器自动平衡两行宽度 */
  line-height:1.28;
}
.main h1 br{ display:none }         /* 源 md 里的换行不强制断 */
.main h1 br::after{ content:' ' }

/* 图表节点：加宽间距，<br/> 换行才不堆叠 */
.main .mermaid-wrap svg{
  max-width:100%;
  height:auto;
}
.main .mermaid-wrap .nodeLabel,
.main .mermaid-wrap .labelText,
.main .mermaid-wrap text{
  font-family:var(--sans)!important;
  font-size:13px!important;
  line-height:1.5!important;
}
.main .mermaid-wrap .node rect,
.main .mermaid-wrap .node polygon,
.main .mermaid-wrap .node circle{
  rx:5px; ry:5px;
}

/* ═══════════════════════════════════════════════════════════════
   专注模式退出按钮修复
   Bug：顶栏整体 visibility:hidden → 退出按钮一起隐藏 → 真人点不到
   修法：顶栏不用 visibility，改用 opacity + pointer-events；
        退出按钮单独保持可见可点（focus 态常显，hover 展开全栏）
   ═══════════════════════════════════════════════════════════════ */

/* 隐藏的元素不能兜底 visibility:hidden —— 那样连按钮一起没了 */
html.focus-mode .toc,
html.focus-mode .footer,
html.focus-mode .pager,
html.focus-mode .keyhint{ display:none !important }

html.focus-mode .topbar{
  display:block;
  opacity:0;
  pointer-events:none;            /* 默认不吃鼠标 */
  position:fixed;
  top:8px;left:50%;
  transform:translateX(-50%);
  background:var(--bg-card);
  box-shadow:var(--shadow-2);
  border:1px solid var(--line);
  border-radius:999px;
  padding:5px 9px;
  z-index:60;
  transition:opacity .22s var(--ease);
  min-height:34px;
}
html.focus-mode .topbar .nav,
html.focus-mode .topbar .brand,
html.focus-mode .topbar .theme-switch,
html.focus-mode .topbar .overflow-btn{ display:none }

/* 关键：退出按钮永远可见可点，不随顶栏淡出 */
html.focus-mode .focus-btn-top{
  display:inline-flex !important;
  align-items:center;gap:6px;
  opacity:1 !important;
  pointer-events:auto !important;
  background:var(--accent);
  color:var(--fg-inv);
  border-color:var(--accent);
  cursor:pointer;
  white-space:nowrap;
}
html.focus-mode .focus-btn-top::after{
  content:'退出';
  font-size:11.5px;
  opacity:.85;
}
html.focus-mode .focus-btn-top:hover{
  background:var(--accent-2);
  border-color:var(--accent-2);
}
/* 顶栏其余部分 hover 展开（键鼠用户），但不影响退出按钮 */
html.focus-mode .topbar:hover{ opacity:1 }
/* ⚠️ 导航已从「平铺链接」改成「胶囊 + 面板」，默认 display 是 block，
   这里不能用 flex（会把胶囊挤成一行）。 */
html.focus-mode .topbar:hover .nav{ display:block }

@media(max-width:640px){
  html.focus-mode .topbar{ top:6px; padding:4px 7px }
}

/* ═══════════════════════════════════════════════════════════════
   专注模式退出浮标（右下角常驻）
   设计动机：退出入口原本藏在屏幕正上方中间的顶栏里，用户找不到/点不到，
   误以为"退不出去"。这里做一个完全脱离 .topbar 的常驻浮标，
   只受 html.focus-mode 控制，不受任何 visibility/display 隐藏规则波及。
   ═══════════════════════════════════════════════════════════════ */

.focus-exit-fab{ display:none }

html.focus-mode .focus-exit-fab{
  display:inline-flex;
  align-items:center;
  gap:7px;
  position:fixed;
  right:24px;
  bottom:26px;
  z-index:90;                 /* 高于 topbar(60) 与搜索面板，确保永远在最上层 */
  padding:11px 18px;
  border-radius:999px;
  background:var(--accent);
  color:var(--fg-inv);
  border:1px solid var(--accent);
  box-shadow:var(--shadow-2);
  font-family:inherit;
  font-size:13px;
  font-weight:600;
  line-height:1;
  cursor:pointer;
  opacity:.94;
  transition:opacity .18s var(--ease), transform .18s var(--ease);
}
html.focus-mode .focus-exit-fab:hover{
  opacity:1;
  transform:translateY(-2px);
}
html.focus-mode .focus-exit-fab:active{ transform:translateY(0) }
html.focus-mode .focus-exit-fab:focus-visible{
  outline:2px solid var(--accent);
  outline-offset:3px;
}
html.focus-mode .focus-exit-dot{
  width:7px;height:7px;border-radius:50%;
  background:var(--fg-inv);
  opacity:.75;
  flex:none;
}
@media(max-width:640px){
  html.focus-mode .focus-exit-fab{
    right:14px; bottom:16px;
    padding:10px 15px; font-size:12.5px;
  }
}

/* ═══════════════════════════════════════════════════════════════
   整合自外部笔记模板（蓝白风 → 转译为本项目墨绿设计系统）
   借用其「结构」，颜色全部走本项目语义变量：
     · .block.mem      记忆口诀框（紫）
     · .fig/.figcaption 图容器 + 图题（含 mermaid 图 .fig-mermaid）
     · .tag            行内小标签
   ═══════════════════════════════════════════════════════════════ */

/* ---------- 记忆口诀框（紫）---------- */
/* 紫色只用在标题与色条上，正文保持统一米白底 */
.mem{color:var(--mem-fg)}
.mem .block-title{color:var(--mem)}
.main .block.mem .block-title{color:var(--mem)}
/* 口诀正文加重，方便朗读记忆 */
.mem strong{color:var(--mem-fg);font-weight:700}

/* ---------- 图容器 + 图题 ---------- */
.fig{
  margin:1.8em 0;
  padding:16px 18px 12px;
  background:var(--bg-card);
  border:1px solid var(--line);
  border-radius:var(--radius);
  text-align:center;
}
.fig svg{max-width:100%;height:auto}
.fig figcaption{
  margin-top:10px;
  font-size:12.8px;
  line-height:1.6;
  color:var(--fg-2);
  letter-spacing:.02em;
}
/* mermaid 图单独放开内边距，图本身已有留白 */
.fig-mermaid{padding:18px 10px 12px;overflow-x:auto}

/* ── 7. mermaid 图表：防止宽图溢出 + 节点文字截断 ── */
.main .mermaid-wrap{
  overflow-x:auto;
  padding:1.6em 1em;
}
.main .mermaid-wrap svg{
  max-width:100%;
  height:auto;
  min-width:0;
}
/* 图表比容器宽时，允许横向滚动而不是截缩 */
.fig-mermaid{min-width:0}
/* Slidev 手绘 SVG：颜色为深底黑板调（文字 #f2efe4），
   放进浅色正文会隐形 → 套深色卡片还原原始配色。
   ⚠️ 选择器必须带 .main（下文有 `.main .fig{background:var(--bg-card)}`，
      同为 2 类时后者胜出 → 深色底会被浅色覆盖，字又隐形）。
      所以这里用 `.main .fig.fig-slidev`（3 类）压住它。 */
.fig-slidev{padding:14px 10px 10px}
.main .fig.fig-slidev,
.fig.fig-slidev{
  background:#142b20;
  border-color:#24402f;
}
.fig-slidev svg{width:100%;height:auto;max-height:420px}
.main .fig{background:var(--bg-card)}
.main .fig figcaption{color:var(--fg-2)}

/* ---------- 行内小标签 ---------- */
.tag{
  display:inline-block;
  padding:1px 9px;
  margin-right:5px;
  border-radius:999px;
  font-size:11.5px;
  font-weight:600;
  line-height:1.7;
  background:var(--accent-soft);
  color:var(--accent);
  border:1px solid var(--accent-soft-2);
  white-space:nowrap;
}
.tag.warn{background:var(--warn-bg);color:var(--warn-fg);border-color:var(--warn-line)}
.tag.exam{background:var(--gold-bg);color:var(--gold);border-color:var(--gold)}
.tag.mem{background:var(--mem-bg);color:var(--mem-line);border-color:var(--mem-line)}
.main .tag{font-family:var(--sans)}

/* ═══════════════════════════════════════════════════════════════
   增强 v1：返回顶部 / 外链指示器 / 代码复制 / 阅读时长
   ═══════════════════════════════════════════════════════════════ */

/* ── 返回顶部按钮 ── */
.back-top{
  position:fixed;right:24px;bottom:80px;z-index:85;
  width:42px;height:42px;
  border-radius:50%;
  background:var(--bg-card);
  border:1.5px solid var(--line);
  box-shadow:var(--shadow-2);
  color:var(--fg-3);cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  font-size:18px;line-height:1;
  opacity:0;transform:translateY(12px);
  pointer-events:none;
  transition:opacity .25s var(--ease),transform .25s var(--ease),color .18s var(--ease),border-color .18s var(--ease);
}
.back-top.show{opacity:1;transform:none;pointer-events:auto}
.back-top:hover{color:var(--accent);border-color:var(--accent);transform:translateY(-2px)}
.back-top:active{transform:translateY(0)}
@media(max-width:760px){
  .back-top{right:14px;bottom:70px;width:38px;height:38px;font-size:16px}
}

/* ── 外链指示器 ── */
a[href^="http"]:not(.cta):not(.pg)::after{
  content:'↗';
  display:inline-block;
  margin-left:2px;
  font-size:.82em;
  opacity:.6;
  vertical-align:.05em;
  transition:opacity .15s var(--ease);
}
a[href^="http"]:not(.cta):not(.pg):hover::after{opacity:1}

/* ── 代码块复制按钮 ── */
.code-wrap{position:relative;margin:1.3em 0}
.copy-btn{
  position:absolute;top:8px;right:8px;
  padding:5px 11px;
  font-size:11.5px;font-family:var(--sans);
  background:var(--bg-card);
  border:1px solid var(--line);
  border-radius:5px;
  color:var(--fg-3);cursor:pointer;
  opacity:0;
  transition:all .18s var(--ease);
  z-index:2;
}
.code-wrap:hover .copy-btn,
.copy-btn:focus{opacity:1}
.copy-btn:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-soft)}
.copy-btn.copied{border-color:var(--tip-line);color:var(--tip);background:var(--tip-bg)}
.code-wrap pre{margin:0;border-radius:var(--radius)}

/* ── 阅读时长（章节页标题下方） ── */
.read-time{
  display:flex;align-items:center;gap:7px;
  font-size:12px;color:var(--fg-3);
  margin-top:-8px;margin-bottom:18px;
  padding-bottom:14px;
  border-bottom:1px solid var(--line);
}
.read-time::before{content:'🕐';font-size:13px;filter:saturate(.7)}

/* ── Quiz 答错时给错误选项加红色标记 ── */
.opt.wrong-pick{border-color:var(--danger-line);background:var(--danger-bg)}
.opt.wrong-pick .letter{background:var(--danger-line);color:#fff;border-color:var(--danger-line)}

/* ── 表格斑马纹（可选，通过 class 控制） ── */
table.zebra tbody tr:nth-child(even){background:var(--accent-soft)}
table.zebra tbody tr:hover{background:var(--accent-soft-2)}

/* ── 统计卡 hover 微动 ── */
.stat{transition:transform .2s var(--ease),box-shadow .2s var(--ease)}
.stat:hover{transform:translateY(-3px);box-shadow:var(--shadow-3)}

/* ── 封面 CTA 按钮点击反馈 ── */
.cta:active{transform:translateY(0) scale(.97)}

/* ── 平滑滚动偏移（锚点跳转不卡顶栏下） ── */
html{scroll-padding-top:80px}
@media(max-width:760px){html{scroll-padding-top:70px}}

/* ═══════════════════════════════════════════════════════════════
   历年真题区块 · 三级折叠（原生 details，零 JS）
   ═══════════════════════════════════════════════════════════════ */
.exam{margin:2.2em 0 1.6em}

/* ── 统计条：常驻不折叠，避免"用户不知道里面有真题"而白做 ── */
.exam-bar{
  display:flex;align-items:center;gap:12px;flex-wrap:wrap;
  padding:12px 16px;margin-bottom:10px;
  background:linear-gradient(180deg,var(--bg-card) 0%,var(--bg-alt) 100%);
  border:1px solid var(--line);border-radius:var(--radius);
  box-shadow:var(--shadow-1);
}
.exam-bar-label{font-weight:700;font-size:14px;color:var(--accent)}
.exam-bar-stat{font-size:12.5px;color:var(--fg-3);flex:1;min-width:140px}
.exam-bar-stat b{color:var(--fg-2);font-variant-numeric:tabular-nums}
.exam-bar-ops{display:flex;gap:6px}
.exam-op{
  padding:4px 11px;font:inherit;font-size:12px;cursor:pointer;
  background:var(--bg-card);border:1px solid var(--line-2);
  border-radius:999px;color:var(--fg-2);
  transition:border-color .18s var(--ease),color .18s var(--ease),background .18s var(--ease);
}
.exam-op:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-soft)}

/* ── 科目级折叠 ── */
.exam-subject{
  border:1px solid var(--line);border-radius:var(--radius);
  background:var(--bg-card);overflow:hidden;
}
.exam-subject>summary{
  display:flex;align-items:center;gap:10px;flex-wrap:wrap;
  padding:12px 16px;cursor:pointer;list-style:none;
  font-weight:600;color:var(--fg-2);
  transition:background .18s var(--ease),color .18s var(--ease);
}
.exam-subject>summary::-webkit-details-marker{display:none}
.exam-subject>summary:hover{background:var(--accent-soft);color:var(--accent)}
.exam-subject[open]>summary{border-bottom:1px solid var(--line);background:var(--bg-alt)}
.exam-subject-name::before{content:'▸ ';display:inline-block;transition:transform .2s var(--ease)}
.exam-subject[open] .exam-subject-name::before{transform:rotate(90deg)}
.exam-subject-n{font-size:12px;color:var(--fg-3);font-variant-numeric:tabular-nums}
.exam-subject-tip{margin-left:auto;font-size:11.5px;color:var(--fg-3);opacity:.8}

/* ── 年份级折叠 ── */
.exam-year{border-bottom:1px solid var(--line)}
.exam-year:last-child{border-bottom:0}
.exam-year>summary{
  display:flex;align-items:center;gap:10px;
  padding:9px 16px 9px 30px;cursor:pointer;list-style:none;
  font-size:13.5px;color:var(--fg-2);
  transition:background .16s var(--ease),color .16s var(--ease);
}
.exam-year>summary::-webkit-details-marker{display:none}
.exam-year>summary:hover{background:var(--accent-soft);color:var(--accent)}
.exam-year[open]>summary{background:var(--bg-alt)}
.exam-year-name::before{content:'▸ ';display:inline-block;transition:transform .2s var(--ease);color:var(--fg-3)}
.exam-year[open] .exam-year-name::before{transform:rotate(90deg)}
.exam-year-n{font-size:11.5px;color:var(--fg-3);font-variant-numeric:tabular-nums}

/* ── 单题折叠 ── */
.exam-q{border-top:1px solid var(--line)}
.exam-q>summary{
  display:flex;align-items:flex-start;gap:10px;
  padding:9px 16px 9px 46px;cursor:pointer;list-style:none;
  font-size:13.5px;line-height:1.6;color:var(--fg-2);
  transition:background .16s var(--ease);
}
.exam-q>summary::-webkit-details-marker{display:none}
.exam-q>summary:hover{background:var(--accent-soft)}
.exam-q[open]>summary{background:var(--bg-alt)}
.exam-q>summary::before{
  content:'＋';flex-shrink:0;width:1.1em;text-align:center;
  color:var(--fg-3);font-size:12px;line-height:1.5;
}
.exam-q[open]>summary::before{content:'－';color:var(--accent)}
.exam-no{
  flex-shrink:0;font-size:11px;color:var(--fg-3);
  font-variant-numeric:tabular-nums;padding-top:2px;min-width:44px;
}
.exam-tag{
  flex-shrink:0;font-size:10.5px;padding:1px 6px;border-radius:4px;
  background:var(--warn-bg);color:var(--warn-fg);border:1px solid var(--warn-line);
}
.exam-stem-peek{
  flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  color:var(--fg-2);
}
.exam-q[open] .exam-stem-peek{color:var(--fg)}
.exam-q-body{padding:4px 16px 16px 46px}
.exam-stem{margin:.6em 0;font-size:14.5px;line-height:1.8;color:var(--fg)}
.exam-blank{color:var(--danger);padding:0 1px}
.exam-opts{list-style:none;margin:.5em 0 .9em;padding:0}
/* ⚠️ 必须清掉全局 `ul>li::before` 的圆点（本站正文列表有项目符号），
   否则真题选项前会多出一个小圆点，位置还和字母块错开 */
.exam-opts>li::before{content:none !important}
.exam-opts li{
  position:relative;padding:4px 0 4px 26px;font-size:14px;line-height:1.7;
  border-bottom:1px dashed var(--line);
}
.exam-opts li:last-child{border-bottom:0}
.exam-opts b{
  position:absolute;left:0;top:4px;
  display:inline-flex;align-items:center;justify-content:center;
  width:19px;height:19px;border-radius:5px;
  background:var(--bg-alt);border:1px solid var(--line-2);
  font-size:11px;font-weight:700;color:var(--fg-3);
}

/* ── 答案（默认再折叠一层）── */
.exam-ans{margin-top:.6em}
.exam-ans>summary{
  display:inline-flex;align-items:center;gap:6px;cursor:pointer;list-style:none;
  padding:4px 12px;font-size:12px;
  background:var(--accent-soft);border:1px solid var(--line-2);
  border-radius:999px;color:var(--accent);
  transition:background .18s var(--ease),border-color .18s var(--ease);
}
.exam-ans>summary::-webkit-details-marker{display:none}
.exam-ans>summary:hover{background:var(--accent-soft-2);border-color:var(--accent)}
.exam-ans[open]>summary{margin-bottom:8px}
.exam-ans-line{margin:.4em 0;font-size:14px;color:var(--fg)}
.exam-ans-line b{
  display:inline-flex;align-items:center;justify-content:center;
  min-width:26px;height:24px;padding:0 8px;margin-left:4px;
  border-radius:6px;background:var(--tip-bg);color:var(--tip-fg);
  border:1px solid var(--tip-line);font-weight:700;
}
.exam-exp{margin:.4em 0;font-size:13.5px;line-height:1.8;color:var(--fg-2)}

/* ── 窄屏 ── */
@media(max-width:760px){
  .exam-bar{padding:10px 12px;gap:8px}
  .exam-bar-label{font-size:13px}
  .exam-bar-stat{font-size:11.5px;flex-basis:100%;order:3;min-width:0}
  .exam-bar-ops{margin-left:auto}
  .exam-subject-tip{display:none}
  .exam-q>summary{padding-left:16px;flex-wrap:wrap}
  .exam-q>summary::before{display:none}
  .exam-no{min-width:0}
  .exam-q-body{padding-left:16px}
  .exam-year>summary{padding-left:20px}
  .exam-stem-peek{white-space:normal;flex-basis:100%}
  .exam-opts li{font-size:13.5px}
}

/* ── 打印：全部自动展开（服务"可打印带水印"卖点）── */
@media print{
  .exam-bar,.exam-op,.exam-ans>summary{display:none !important}
  .exam-subject,.exam-year,.exam-q{border:0 !important;background:none !important}
  .exam-subject>summary,.exam-year>summary{
    padding:6pt 0;background:none !important;border-bottom:1pt solid #999;
  }
  .exam-subject-name::before,.exam-year-name::before,.exam-q>summary::before{content:'' !important}
  .exam-q-body,.exam-ans[open] > div,.exam-ans > div{display:block !important}
  .exam-q{break-inside:avoid;page-break-inside:avoid}
  .exam-stem,.exam-opts li{font-size:9.5pt}
  .exam-exp{font-size:8.5pt;color:#333}
}
</style>
</head>
<body>
<header class="topbar">
  <a class="brand" href="index.html"><span class="brand-mark">48</span><span>阿甘系分</span><span class="brand-sub">冲刺手册</span></a>
  <nav class="nav"><div class="nav" id="chapnav"><button class="nav-trigger" type="button" id="navTrigger" aria-haspopup="true" aria-expanded="false" aria-controls="navPanel" title="章节导航（Enter / ↓ 打开，Esc 关闭）"><span class="nav-trigger-code">H30</span><span class="nav-trigger-label">设计模式与人机</span><svg class="nav-caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 L6 8 L9.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button><div class="nav-panel" id="navPanel" hidden><div class="nav-panel-scroll"><div class="nav-group nav-group-solo"><a class="nav-item" href="index.html"><span class="nav-item-code">首页</span><span class="nav-item-label">首页 · 手册总览</span></a></div><div class="nav-group"><div class="nav-group-title">第一篇 · 基础知识</div><a class="nav-item" href="H01.html"><span class="nav-item-code">H01</span><span class="nav-item-label">绪论与备考总纲</span></a><a class="nav-item" href="H02.html"><span class="nav-item-code">H02</span><span class="nav-item-label">数学与工程基础（一）· 概率统计与图论应用</span></a><a class="nav-item" href="H03.html"><span class="nav-item-code">H03</span><span class="nav-item-label">数学与工程基础（二）· 预测决策与工程伦理</span></a><a class="nav-item" href="H04.html"><span class="nav-item-code">H04</span><span class="nav-item-label">计算机系统（一）· 硬件与体系结构</span></a><a class="nav-item" href="H05.html"><span class="nav-item-code">H05</span><span class="nav-item-label">计算机系统（二）· 操作系统</span></a><a class="nav-item" href="H06.html"><span class="nav-item-code">H06</span><span class="nav-item-label">计算机网络（一）· 数据通信与协议体系</span></a><a class="nav-item" href="H07.html"><span class="nav-item-code">H07</span><span class="nav-item-label">计算机网络（二）· TCP/IP 与网络工程</span></a><a class="nav-item" href="H08.html"><span class="nav-item-code">H08</span><span class="nav-item-label">分布式系统、构件与云计算</span></a><a class="nav-item" href="H09.html"><span class="nav-item-code">H09</span><span class="nav-item-label">数据库系统（一）· 三级模式与关系基础</span></a><a class="nav-item" href="H10.html"><span class="nav-item-code">H10</span><span class="nav-item-label">数据库系统（二）· 范式与事务并发控制</span></a><a class="nav-item" href="H11.html"><span class="nav-item-code">H11</span><span class="nav-item-label">数据库系统（三）· 设计、仓库与 NoSQL</span></a><a class="nav-item" href="H12.html"><span class="nav-item-code">H12</span><span class="nav-item-label">企业信息化（一）· 信息化规划</span></a><a class="nav-item" href="H13.html"><span class="nav-item-code">H13</span><span class="nav-item-label">企业信息化（二）· 信息系统与商务</span></a><a class="nav-item" href="H14.html"><span class="nav-item-code">H14</span><span class="nav-item-label">软件工程（一）· 生命周期与开发模型</span></a><a class="nav-item" href="H15.html"><span class="nav-item-code">H15</span><span class="nav-item-label">软件工程（二）· 过程管理与软件重用</span></a><a class="nav-item" href="H16.html"><span class="nav-item-code">H16</span><span class="nav-item-label">软件工程（三）· UML 与形式化方法</span></a><a class="nav-item" href="H17.html"><span class="nav-item-code">H17</span><span class="nav-item-label">项目管理（一）· 范围进度成本与挣值分析</span></a><a class="nav-item" href="H18.html"><span class="nav-item-code">H18</span><span class="nav-item-label">项目管理（二）· 配置质量风险与文档</span></a><a class="nav-item" href="H19.html"><span class="nav-item-code">H19</span><span class="nav-item-label">信息安全（一）· 安全体系与加密认证</span></a><a class="nav-item" href="H20.html"><span class="nav-item-code">H20</span><span class="nav-item-label">信息安全（二）· 网络安全与可靠性</span></a></div><div class="nav-group"><div class="nav-group-title">第二篇 · 关键技术</div><a class="nav-item" href="H21.html"><span class="nav-item-code">H21</span><span class="nav-item-label">系统规划与分析（一）· 需求分析与 DFD 建模</span></a><a class="nav-item" href="H22.html"><span class="nav-item-code">H22</span><span class="nav-item-label">系统规划与分析（二）· 成本效益与可行性论证</span></a><a class="nav-item" href="H23.html"><span class="nav-item-code">H23</span><span class="nav-item-label">软件需求工程</span></a><a class="nav-item" href="H26.html"><span class="nav-item-code">H26</span><span class="nav-item-label">软件架构设计（一）· 架构定义与 4+1 视图</span></a><a class="nav-item" href="H27.html"><span class="nav-item-code">H27</span><span class="nav-item-label">软件架构设计（二）· 架构风格与 SOA</span></a><a class="nav-item" href="H28.html"><span class="nav-item-code">H28</span><span class="nav-item-label">软件架构设计（三）· 质量属性与 ATAM 评估</span></a><a class="nav-item" href="H29.html"><span class="nav-item-code">H29</span><span class="nav-item-label">系统设计（一）· 结构化设计与面向对象设计</span></a><a class="nav-item active" href="H30.html" aria-current="page"><span class="nav-item-code">H30</span><span class="nav-item-label">系统设计（二）· 设计模式与人机交互</span></a><a class="nav-item" href="H31.html"><span class="nav-item-code">H31</span><span class="nav-item-label">软件实现与测试（一）· 测试原则与黑盒白盒方法</span></a><a class="nav-item" href="H32.html"><span class="nav-item-code">H32</span><span class="nav-item-label">软件实现与测试（二）· 测试阶段与部署发布</span></a><a class="nav-item" href="H33.html"><span class="nav-item-code">H33</span><span class="nav-item-label">系统运行与维护（一）· 运维指标与软件维护</span></a><a class="nav-item" href="H34.html"><span class="nav-item-code">H34</span><span class="nav-item-label">系统运行与维护（二）· 系统转换与演进</span></a></div><div class="nav-group"><div class="nav-group-title">第三篇 · 案例实践</div><a class="nav-item" href="H35.html"><span class="nav-item-code">H35</span><span class="nav-item-label">Web 应用系统分析与设计 · 架构、缓存与测试</span></a><a class="nav-item" href="H36.html"><span class="nav-item-code">H36</span><span class="nav-item-label">嵌入式系统分析与设计 · 实时调度与低功耗</span></a><a class="nav-item" href="H37.html"><span class="nav-item-code">H37</span><span class="nav-item-label">移动应用系统分析与设计 · 架构演进与开发方式选型</span></a><a class="nav-item" href="H38.html"><span class="nav-item-code">H38</span><span class="nav-item-label">大数据处理系统分析与设计 · Lambda/Kappa 架构</span></a><a class="nav-item" href="H39.html"><span class="nav-item-code">H39</span><span class="nav-item-label">微服务系统分析与设计 · 组件、事务与反模式</span></a><a class="nav-item" href="H40.html"><span class="nav-item-code">H40</span><span class="nav-item-label">信息物理系统 CPS · 闭环架构与边缘计算</span></a><a class="nav-item" href="H41.html"><span class="nav-item-code">H41</span><span class="nav-item-label">系统分析师论文写作要点 · 结构、字数与评分</span></a></div><div class="nav-group"><div class="nav-group-title">专项模块 · 案例专项</div><a class="nav-item" href="H42.html"><span class="nav-item-code">H42</span><span class="nav-item-label">案例分析专项（一）· 四步答题法与设问模板</span></a><a class="nav-item" href="H43.html"><span class="nav-item-code">H43</span><span class="nav-item-label">案例分析专项（二）· 考点地图与真题精讲</span></a><a class="nav-item" href="H44.html"><span class="nav-item-code">H44</span><span class="nav-item-label">案例分析专项（三）· 六大方向专项与场景实战</span></a></div><div class="nav-group"><div class="nav-group-title">专项模块</div><a class="nav-item" href="H45.html"><span class="nav-item-code">H45</span><span class="nav-item-label">论文写作专项</span></a><a class="nav-item" href="H46.html"><span class="nav-item-code">H46</span><span class="nav-item-label">论文写作专项（二）· 万能素材卡与考点落点</span></a><a class="nav-item" href="H47.html"><span class="nav-item-code">H47</span><span class="nav-item-label">全真模拟（一）· 上午场综合知识与案例</span></a><a class="nav-item" href="H48.html"><span class="nav-item-code">H48</span><span class="nav-item-label">全真模拟（二）· 下午场论文与复盘方法论</span></a></div><div class="nav-group nav-group-pending"><div class="nav-group-title">待上线 · 按真题权重排序</div><div class="nav-pending-row"><span class="nav-pending-ch">✅ 48 学时已全部上线</span><span class="nav-pending-name">第一篇 9 章 + 第二篇 6 章 + 第三篇 7 章</span><span class="nav-pending-w">22 章</span></div><div class="nav-pending-row"><span class="nav-pending-ch">✅ 专项模块</span><span class="nav-pending-name">案例分析 H42–H44 · 论文 H45–H46 · 全真模拟 H47–H48</span><span class="nav-pending-w">7 学时</span></div></div></div><div class="nav-foot"><span class="nav-foot-tip">↑↓ 选择 · Enter 打开 · Esc 关闭</span><span class="nav-foot-nav"><a class="nav-step" href="H29.html">← 上一章</a><a class="nav-step" href="H31.html">下一章 →</a></span></div></div></div></nav>
