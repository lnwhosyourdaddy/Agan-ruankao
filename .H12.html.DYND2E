</main>
<button class="focus-exit-fab" type="button" title="退出专注模式（F）">
  <span class="focus-exit-dot" aria-hidden="true"></span>退出专注
</button>
<script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"
        onerror="window.__mermaidFailed=true"></script>
<script>/**
 * 阿甘系分 48 小时冲刺 · 独立 HTML 站点
 * 设计系统 + 交互逻辑（内联进每个 HTML，零依赖）
 */
(function () {
  'use strict'

  // ══════════════════════════════════════════
  // 1. 存储层
  // ══════════════════════════════════════════
  const NS = 'xifen48'
  // ⚠️ 多用户隔离：GitHub Pages 部署下所有用户共享同一个源（origin），
  // localStorage 是按源隔离的 → A 用户的答题记录会覆盖 B 用户的。
  // 方案：为每个浏览器档案生成一个随机 UUID，用它做 key 命名空间。
  // 不同 Chrome 档案/不同浏览器 → 不同 UUID → 数据互相隔离。
  // ⚠️ 清浏览器缓存 = 丢失 UUID = 答题记录清零（属正常，和重置功能语义一致）
  function getUserId() {
    let id = localStorage.getItem(NS + ':uid')
    if (!id) {
      id = 'u_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 10)
      localStorage.setItem(NS + ':uid', id)
    }
    return id
  }
  const UID = getUserId()
  const store = {
    get(k, d) { try { const v = localStorage.getItem(NS + ':' + UID + ':' + k); return v ? JSON.parse(v) : d } catch { return d } },
    set(k, v) { try { localStorage.setItem(NS + ':' + UID + ':' + k, JSON.stringify(v)) } catch {} },
    del(k) { try { localStorage.removeItem(NS + ':' + UID + ':' + k) } catch {} }
  }

  // ══════════════════════════════════════════
  // 2. 主题：跟随系统 + 手动覆盖
  // ══════════════════════════════════════════
  const Theme = {
    KEY: 'theme',
    get() { return store.get('theme', 'auto') },
    set(v) {
      store.set('theme', v)
      Theme.apply()
      document.querySelectorAll('.theme-btn').forEach(b => b.classList.toggle('active', b.dataset.theme === v))
    },
    apply() {
      const m = store.get('theme', 'auto')
      const dark = m === 'auto'
        ? window.matchMedia('(prefers-color-scheme: dark)').matches
        : m === 'dark'
      document.documentElement.style.colorScheme = dark ? 'dark' : 'light'
      document.documentElement.dataset.theme = dark ? 'dark' : 'light'
    },
    init() {
      Theme.apply()
      const m = store.get('theme', 'auto')
      document.querySelectorAll('.theme-btn').forEach(b => b.classList.toggle('active', b.dataset.theme === m))
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (store.get('theme', 'auto') === 'auto') Theme.apply()
      })
      // 点击切换：跟随 → 浅 → 深 → 跟随
      document.querySelectorAll('.theme-btn').forEach(btn => {
        btn.addEventListener('click', () => Theme.set(btn.dataset.theme))
      })
    }
  }

  // ══════════════════════════════════════════
  // 3. 阅读进度条
  // ══════════════════════════════════════════
  const Progress = {
    init() {
      const bar = document.createElement('div')
      bar.className = 'read-progress'
      document.body.appendChild(bar)

      const toc = document.querySelector('.toc')
      if (!toc) return
      // 细化到 4 级：h2（学时/大题）→ h3（小节）→ h4（知识条目）→ h5（细项，若有人写更深）
      const heads = [...document.querySelectorAll('.main h2, .main h3, .main h4, .main h5')]
      if (!heads.length) return

      // 必须【先】给每个标题补 id，【再】生成目录链接，
      // 否则 href="#undefined"，点击全部无效（此前踩过）
      heads.forEach((h, i) => {
        if (!h.id) {
          let slug = (h.textContent || '').replace(/\s+/g, '-')
            .replace(/[^\w一-鿿-]/g, '').slice(0, 40)
          if (slug && slug[0].match(/[0-9]/)) slug = 's' + slug   // 数字开头 → CSS 选择器非法
          h.id = slug || ('h' + (i + 1))
        }
        let dup = 0
        for (const other of document.querySelectorAll('[id]')) {
          if (other !== h && other.id === h.id) { dup++; break }
        }
        if (dup) h.id = h.id + '-' + i          // 去重，锚点必须唯一
      })

      // 构建层级：按标题顺序压栈，把 h3/h4/h5 挂到上级下面
      const lvMap = { h2: 0, h3: 1, h4: 2, h5: 3 }
      const nodes = heads.map(h => ({
        el: h,
        lv: lvMap[h.tagName.toLowerCase()],
        text: h.textContent.replace(/<[^>]*>/g, '').trim(),
        id: h.id,
        children: []
      }))
      // 先剥掉 h3/h4/h5 开头（没有 h2 父级）的孤儿节点，否则 roots 会漏
      const roots = []
      const stack = []
      nodes.forEach(n => {
        // 找比自己 lv 小的栈顶作为父
        while (stack.length && stack[stack.length - 1].lv >= n.lv) stack.pop()
        if (stack.length) stack[stack.length - 1].children.push(n)
        else roots.push(n)              // 无父级 → 顶级（本身就是 h2）
        stack.push(n)
      })

      const renderTree = (list, depth) =>
        list.map(n => {
          const hasSub = n.children.length
          return `<div class="toc-group${hasSub ? '' : ' leaf'}">
            <a href="#${n.id}" class="toc-item toc-l${n.lv + 1}" style="--depth:${depth}">${n.text}</a>
            ${hasSub ? '<div class="toc-sub">' + renderTree(n.children, depth + 1) + '</div>' : ''}
          </div>`
        }).join('')

      toc.innerHTML =
        '<div class="toc-title">本页目录</div>' +
        '<div class="toc-tree">' + renderTree(roots, 0) + '</div>'

      // 折叠交互：点击有子节点的 a 右侧空白 → 展开/收缩
      toc.querySelectorAll('.toc-group > .toc-item').forEach(a => {
        if (!a.parentElement.querySelector('.toc-sub')) return
        a.style.cursor = 'pointer'
        a.addEventListener('click', e => {
          if (e.target !== a) return
          a.parentElement.classList.toggle('collapsed')
        })
      })

      // 高亮：取最近经过的标题，并点亮它到根的整条祖先链
      const links = [...toc.querySelectorAll('.toc-item')]
      const linkById = {}
      links.forEach(a => { linkById[a.getAttribute('href').slice(1)] = a })
      // 递归找祖先：从根往下走到 node，返回路径
      const pathOf = (node, chain = []) => {
        for (const n of roots) {
          const hit = walk(n, node, [...chain, n])
          if (hit) return hit
        }
        return [node]
      }
      function walk(n, target, chain) {
        if (n === target) return chain
        for (const c of n.children) {
          const r = walk(c, target, [...chain, c])
          if (r) return r
        }
        return null
      }
      const update = () => {
        const y = window.scrollY + 130
        let cur = null
        heads.forEach(h => { if (h.offsetTop <= y + 1) cur = h })
        links.forEach(a => a.classList.remove('active'))
        if (cur) {
          const node = nodes.find(n => n.el === cur)
          if (node) {
            pathOf(node).forEach(n => {
              const a = linkById[n.id]
              if (a) a.classList.add('active')
            })
          }
        }
        const max = document.body.scrollHeight - window.innerHeight
        bar.style.width = (max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0) + '%'
      }
      window.addEventListener('scroll', update, { passive: true })
      update()
    }
  }

  // ══════════════════════════════════════════
  // 4. Quiz：答题 + 判分 + 错题本 + 进度
  // 注意：store.get/set 内部已自动加 "xifen48:" 前缀，
  //所以这里传的 key 不要再带 NS，否则会出现 "xifen48:xifen48:xxx"
  // ══════════════════════════════════════════
  const Quiz = {
    wrongKey(page) { return 'wrong:' + page },
    answersKey(page) { return 'ans:' + page },

    init(root) {
      const page = root.dataset.key
      const answers = store.get(this.answersKey(page), {})
      let wrong = store.get(this.wrongKey(page), [])

      const total = root.querySelectorAll('.quiz-item').length
      const updateBar = () => {
        const done = root.querySelectorAll('.quiz-item.done').length
        const right = root.querySelectorAll('.quiz-item.correct').length
        const pct = total ? Math.round((right / total) * 100) : 0
        root.querySelector('.quiz-progress').innerHTML =
          `已答 <b>${done}</b>/${total}` +
          (done ? ` · 正确 <b>${right}</b> · 正确率 <b>${pct}%</b>` : '')
        const bar = root.querySelector('.quiz-pbar-fill')
        if (bar) bar.style.width = pct + '%'
      }

      root.querySelectorAll('.quiz-item').forEach((item, i) => {
        const correct = item.dataset.answer
        const explain = item.dataset.explain || ''
        const ref = item.dataset.ref || ''
        item.querySelectorAll('.opt').forEach(opt => {
          opt.addEventListener('click', () => {
            if (item.classList.contains('done')) return
            const letter = opt.dataset.letter
            item.classList.add('done')
            opt.classList.add('picked')
            const ok = letter === correct
            item.classList.add(ok ? 'correct' : 'wrong')
            item.querySelector('.reveal').style.display = 'block'
            item.querySelector('.reveal-verdict').innerHTML = ok
              ? '✅ 回答正确<span class="answer">正确答案 ' + correct + '</span>'
              : '❌ 回答错误<span class="answer">正确答案 ' + correct + '</span>'
            if (!ok) {
              item.querySelector('.opt[data-letter="' + correct + '"]').classList.add('right')
              opt.classList.add('wrong-pick')
            }

            // 错题本
            const cur = store.get(this.answersKey(page), {})
            cur[i] = letter
            store.set(this.answersKey(page), cur)
            const w = store.get(this.wrongKey(page), [])
            if (!ok && !w.includes(i)) { w.push(i); store.set(this.wrongKey(page), w) }
            else if (ok) store.set(this.wrongKey(page), w.filter(x => x !== i))

            updateBar()
            window.dispatchEvent(new CustomEvent('quiz:update', { detail: { page } }))
          })
        })

        // 恢复
        const picked = answers[i]
        if (picked) {
          item.classList.add('done')
          item.querySelector('.opt[data-letter="' + picked + '"]').classList.add('picked')
          const ok = picked === correct
          item.classList.add(ok ? 'correct' : 'wrong')
          item.querySelector('.reveal').style.display = 'block'
          item.querySelector('.reveal-verdict').innerHTML = ok
            ? '✅ 回答正确<span class="answer">正确答案 ' + correct + '</span>'
            : '❌ 回答错误<span class="answer">正确答案 ' + correct + '</span>'
          if (!ok) item.querySelector('.opt[data-letter="' + correct + '"]').classList.add('right')
        }
      })

      root.querySelector('.quiz-reset').addEventListener('click', () => {
        store.del(this.answersKey(page))
        store.del(this.wrongKey(page))
        root.querySelectorAll('.quiz-item').forEach(it => {
          it.classList.remove('done', 'correct', 'wrong')
          it.querySelectorAll('.opt').forEach(o => o.classList.remove('picked', 'right'))
          it.querySelector('.reveal').style.display = 'none'
        })
        updateBar()
        window.dispatchEvent(new CustomEvent('quiz:update'))
      })

      // 导出本学时答题记录
      root.querySelector('.quiz-export')?.addEventListener('click', () => {
        const cur = store.get(this.answersKey(page), {})
        const total = root.querySelectorAll('.quiz-item').length
        const right = root.querySelectorAll('.quiz-item.correct').length
        const rows = []
        for (let i = 0; i < total; i++) {
          rows.push(`${i + 1}. ${cur[i] || '未答'}${cur[i] && cur[i] === root.querySelectorAll('.quiz-item')[i].dataset.answer ? ' ✓' : cur[i] ? ' ✗' : ''}`)
        }
        const blob = new Blob([
          `阿甘系分 48 小时冲刺 · 答题记录\n${page}\n` +
          `正确 ${right}/${total}（${Math.round((right / total) * 100)}%）\n生成时间：${new Date().toLocaleString('zh-CN')}\n\n` +
          rows.join('\n')
        ], { type: 'text/plain;charset=utf-8' })
        const a = document.createElement('a')
        a.href = URL.createObjectURL(blob)
        a.download = page.replace(/\.md$/, '') + '-答题记录.txt'
        a.click()
        URL.revokeObjectURL(a.href)
      })

      updateBar()
      return { total, page }
    }
  }

  // ══════════════════════════════════════════
  // 5. 全站错题本（跨页汇总）
  // ══════════════════════════════════════════
  const WrongBook = {
    collect() {
      const idx = []
      const prefix = NS + ':' + UID + ':wrong:'
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i)
        if (k && k.startsWith(prefix)) {
          const page = k.slice(prefix.length)
          const arr = store.get('wrong:' + page, [])
          if (arr.length) idx.push({ page, count: arr.length, items: arr })
        }
      }
      return idx.sort((a, b) => b.count - a.count)
    },
    render() {
      const panel = document.querySelector('.wrongbook')
      if (!panel) return
      const idx = this.collect()
      if (!idx.length) {
        panel.innerHTML = '<div class="wb-empty">暂无错题记录 — 做完练习后这里会自动汇总</div>'
        return
      }
      panel.innerHTML =
        '<div class="wb-head"><span>📕 错题本</span><span class="wb-total">' +
        idx.reduce((n, x) => n + x.count, 0) + ' 道错题 · ' + idx.length + ' 个学时</span></div>' +
        idx.map(x =>
          `<div class="wb-row"><a href="${x.page.replace(/\.md$/, '.html')}">${x.page.replace(/\.md$/, '')}</a>` +
          `<span class="wb-count">${x.count} 道</span></div>`
        ).join('') +
        '<button class="wb-clear" data-act="wb-clear">清空错题本</button>'

      panel.querySelector('[data-act="wb-clear"]')?.addEventListener('click', () => {
        if (!confirm('确定要清空当前浏览器的错题本吗？此操作不可恢复。')) return
        idx.forEach(x => store.del('wrong:' + x.page))
        this.render()
      })
    },
    init() { this.render(); window.addEventListener('quiz:update', () => this.render()) }
  }

  // ══════════════════════════════════════════
  // 6. 快捷键
  // ══════════════════════════════════════════
  /* ---------- 章首进度条：随滚动更新「读到第几节 / 全书第几学时」 ---------- */
  const ChapBar = {
    init() {
      const bar = document.getElementById('chapbar')
      if (!bar) return
      this.bar = bar
      this.fill = document.getElementById('chapbarFill')
      this.sec = document.getElementById('chapbarSec')
      this.secs = [...document.querySelectorAll('.main h2[id], .main h3[id]')]
      this.total = Number(bar.dataset.secTotal) || this.secs.length
      if (!this.secs.length) return
      this.cur = -1
      this.onScroll = this.update.bind(this)
      window.addEventListener('scroll', this.onScroll, { passive: true })
      this.update()
    },
    update() {
      // 以"视口上沿往下 120px"为判定线，取该位置之后最近的标题
      const line = 140
      let idx = 0
      for (let i = 0; i < this.secs.length; i++) {
        const t = this.secs[i].getBoundingClientRect().top
        if (t - line <= 0) idx = i
        else break
      }
      if (idx !== this.cur) {
        this.cur = idx
        if (this.sec) this.sec.textContent = (idx + 1) + ' / ' + this.total
      }
      // 整页滚动进度（含末尾）
      const doc = document.documentElement
      const max = doc.scrollHeight - doc.clientHeight
      const p = max > 0 ? Math.min(1, Math.max(0, doc.scrollTop / max)) : 0
      if (this.fill) this.fill.style.width = (p * 100).toFixed(2) + '%'
    }
  }

  /* ---------- 章节导航：胶囊触发器 + 分组下拉面板 ---------- */
  const ChapNav = {
    root: null, trigger: null, panel: null, items: [], cursor: -1,

    init() {
      this.root = document.getElementById('chapnav')
      if (!this.root) return
      this.trigger = document.getElementById('navTrigger')
      this.panel = document.getElementById('navPanel')
      if (!this.trigger || !this.panel) return
      this.items = [...this.panel.querySelectorAll('.nav-item')]

      this.trigger.addEventListener('click', e => {
        e.stopPropagation()
        // ⚠️ 键盘在触发器上按 Enter/Space 时，浏览器会在 keydown 之后**再合成一次 click**。
        //    若 keydown 里已经打开面板，这次 click 就会立刻把它关掉（表现为"按 Enter 闪一下又没了"）。
        //    用一次性标记吞掉紧随其后的那次 click。
        if (this._swallowClick) { this._swallowClick = false; return }
        this.toggle()
      })
      // 面板内点击：跳转交给 <a> 默认行为，但要点空白处不关闭、点链接才关
      this.panel.addEventListener('click', e => {
        if (e.target.closest('.nav-item')) this.close()
      })
      // 点外部关闭
      document.addEventListener('click', e => {
        if (!this.root.contains(e.target)) this.close()
      })
      document.addEventListener('keydown', e => this.onKey(e), true)
      // 视口变窄时自动关掉，避免面板悬在半个屏幕外
      window.addEventListener('resize', () => { if (this.isOpen()) this.close() })
    },

    isOpen() { return !this.panel.hasAttribute('hidden') },

    open() {
      this.panel.removeAttribute('hidden')
      this.root.classList.add('open')
      this.trigger.setAttribute('aria-expanded', 'true')
      // 打开后把当前页滚进视野，并让「当前项」成为键盘游标
      const act = this.items.findIndex(a => a.classList.contains('active'))
      this.cursor = act >= 0 ? act : 0
      const cur = this.items[this.cursor]
      if (cur) {
        const box = this.panel.querySelector('.nav-panel-scroll')
        if (box && cur.offsetTop < box.scrollTop) box.scrollTop = Math.max(0, cur.offsetTop - 12)
        else if (box && cur.offsetTop + cur.offsetHeight > box.scrollTop + box.clientHeight)
          box.scrollTop = cur.offsetTop + cur.offsetHeight - box.clientHeight + 12
      }
    },

    close() {
      if (!this.isOpen()) return
      this.panel.setAttribute('hidden', '')
      this.root.classList.remove('open')
      this.trigger.setAttribute('aria-expanded', 'false')
    },

    toggle() { this.isOpen() ? this.close() : this.open() },

    focusCursor() {
      const a = this.items[this.cursor]
      if (a) { a.focus(); return }
      this.trigger.focus()
    },

    onKey(e) {
      if (!this.isOpen()) {
        // 未打开时：Enter / ↓ / Alt+↓ 直接开面板
        if (this.root.contains(e.target) && (e.key === 'Enter' || e.key === 'ArrowDown' || e.key === ' ')) {
          e.preventDefault()
          this._swallowClick = true          // 吞掉紧随其后的合成 click
          this.open()
          this.focusCursor()
          // 安全阀：若浏览器这次没派发 click，标记要能过期，否则下一次真鼠标点击会被吞
          setTimeout(() => { this._swallowClick = false }, 120)
        }
        return
      }
      if (e.key === 'Escape') { e.preventDefault(); this.close(); this.trigger.focus(); return }
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault()
        const d = e.key === 'ArrowDown' ? 1 : -1
        this.cursor = (this.cursor + d + this.items.length) % this.items.length
        this.focusCursor()
        return
      }
      if (e.key === 'Home') { e.preventDefault(); this.cursor = 0; this.focusCursor(); return }
      if (e.key === 'End') {
        e.preventDefault(); this.cursor = this.items.length - 1; this.focusCursor(); return
      }
      // Tab 走出面板就自动收起
      if (e.key === 'Tab') this.close()
    }
  }

  const Keys = {
    init() {
      document.addEventListener('keydown', e => {
        // e.target 可能是 document（无 matches 方法），必须先判断
        const t = e.target
        if (t && t.nodeType === 1 && t.matches('input,textarea,select,[contenteditable]')) return
        if (e.metaKey || e.ctrlKey || e.altKey) return

        const k = e.key.toLowerCase()
        if (k === 't') {
          // auto 状态下先按当前实际渲染的主题取反，落成明确值
          const cur = document.documentElement.dataset.theme
          Theme.set(cur === 'dark' ? 'light' : 'dark')
          e.preventDefault()
        } else if (k === 'p') {
          // P：跳到下一未答题并选中第一选项
          const next = [...document.querySelectorAll('.quiz-item')]
            .find(it => !it.classList.contains('done'))
          if (next) {
            next.querySelector('.opt')?.click()
            next.scrollIntoView({ behavior: 'smooth', block: 'center' })
          }
          e.preventDefault()
        } else if (k === '0') {
          // 0：回顶部
          window.scrollTo({ top: 0, behavior: 'smooth' })
          e.preventDefault()
        } else if (k === 'g') {
          // g：上一未答题（与 P 反方向）
          const items = [...document.querySelectorAll('.quiz-item.done')]
          if (items.length) {
            items[items.length - 1].scrollIntoView({ behavior: 'smooth', block: 'center' })
          }
          e.preventDefault()
        } else if (k === 'j' || k === 'k') {
          // j/k：快速滚动 1/3 页
          const d = k === 'j' ? 1 : -1
          window.scrollBy({ top: window.innerHeight * d * 0.6, behavior: 'smooth' })
          e.preventDefault()
        }
      })
    }
  }

  // ══════════════════════════════════════════
  // 7. 全文搜索（当前页，Cmd/Ctrl+K 呼出）
  // ══════════════════════════════════════════
  const Search = {
    init() {
      // 索引：本页所有块级内容（标题/段落/表格行/提示框/题目）
      const idx = []
      const push = (text, anchor, kind) => {
        const t = (text || '').replace(/\s+/g, ' ').trim()
        if (t.length >= 2) idx.push({ t: t.toLowerCase(), raw: t, anchor, kind })
      }
      document.querySelectorAll('.main h2[id], .main h3[id], .main h4[id]').forEach(h => {
        push(h.textContent, h.id, '标题')
      })
      document.querySelectorAll('.main p, .main li').forEach(el => {
        // 找到最近的上级标题作为锚点
        let a = null, n = el
        while (n && n !== document.body) {
          if (n.previousElementSibling && n.previousElementSibling.id) { a = n.previousElementSibling.id; break }
          n = n.previousElementSibling
        }
        push(el.textContent, a || '', '正文')
      })
      document.querySelectorAll('.main tbody tr').forEach(tr => {
        push(tr.textContent, '', '表格')
      })
      document.querySelectorAll('.main .block, .main .quote').forEach(b => {
        push(b.textContent, '', '提示')
      })
      document.querySelectorAll('.quiz-q').forEach(q => push(q.textContent, '', '题目'))

      if (!idx.length) return

      // UI
      const panel = document.createElement('div')
      panel.className = 'search-panel'
      panel.innerHTML = `
        <div class="search-box">
          <input class="search-input" type="search" placeholder="搜索本页内容…  (Esc 关闭)" autocomplete="off">
          <span class="search-count"></span>
        </div>
        <ul class="search-results"></ul>`
      document.body.appendChild(panel)
      const input = panel.querySelector('.search-input')
      const list = panel.querySelector('.search-results')
      const count = panel.querySelector('.search-count')

      let hits = [], cur = -1
      const open = () => { panel.classList.add('open'); input.focus(); input.select() }
      const close = () => { panel.classList.remove('open'); input.value = ''; list.innerHTML = ''; hits = []; cur = -1 }

      function run(q) {
        q = q.trim().toLowerCase()
        if (!q) { list.innerHTML = ''; count.textContent = ''; hits = []; return }
        hits = idx.filter(x => x.t.includes(q)).slice(0, 40)
        count.textContent = hits.length ? `${hits.length} 条` : '无结果'
        cur = hits.length ? 0 : -1
        list.innerHTML = hits.map((h, i) => {
          const p = h.raw.indexOf(q)
          const snip = p < 0 ? h.raw.slice(0, 90)
            : (p > 30 ? '…' : '') + h.raw.slice(Math.max(0, p - 30), p + 70) + (p + 70 < h.raw.length ? '…' : '')
          return `<li class="search-hit${i === cur ? ' cur' : ''}" data-i="${i}">
            <span class="hit-kind">${h.kind}</span><span class="hit-text">${escapeHtml(snip)}</span></li>`
        }).join('')
      }

      function goto(i) {
        const h = hits[i]
        if (!h) return
        if (h.anchor) {
          const t = document.getElementById(h.anchor)
          if (t) { t.scrollIntoView({ behavior: 'smooth', block: 'start' }); flash(t) }
        }
        // 高亮正文里的命中词
        document.querySelectorAll('.search-mark').forEach(m => {
          m.outerHTML = m.textContent
        })
        const walker = document.createTreeWalker(document.querySelector('.main'), NodeFilter.SHOW_TEXT)
        const targets = []
        let n
        while ((n = walker.nextNode())) if (n.nodeValue.toLowerCase().includes(input.value.trim().toLowerCase())) targets.push(n)
        targets.slice(0, 40).forEach(node => {
          const frag = document.createDocumentFragment()
          const parts = node.nodeValue.split(new RegExp('(' + escapeRe(input.value.trim()) + ')', 'ig'))
          parts.forEach(p => {
            if (p.toLowerCase() === input.value.trim().toLowerCase()) {
              const m = document.createElement('mark')
              m.className = 'search-mark'; m.textContent = p; frag.appendChild(m)
            } else frag.appendChild(document.createTextNode(p))
          })
          node.parentNode.replaceChild(frag, node)
        })
        if (targets.length) {
          const first = document.querySelector('.search-mark')
          if (first) { first.scrollIntoView({ behavior: 'smooth', block: 'center' }); flash(first) }
        }
      }

      function flash(el) {
        el.classList.add('flash-hit')
        setTimeout(() => el.classList.remove('flash-hit'), 1200)
      }

      input.addEventListener('input', () => run(input.value))
      input.addEventListener('keydown', e => {
        if (e.key === 'Escape') { close(); e.stopPropagation() }
        else if (e.key === 'ArrowDown') { cur = Math.min(cur + 1, hits.length - 1); renderCur(); e.preventDefault() }
        else if (e.key === 'ArrowUp') { cur = Math.max(cur - 1, 0); renderCur(); e.preventDefault() }
        else if (e.key === 'Enter') { goto(cur); e.preventDefault() }
      })
      const renderCur = () => {
        list.querySelectorAll('.search-hit').forEach((el, i) => el.classList.toggle('cur', i === cur))
      }
      list.addEventListener('click', e => {
        const li = e.target.closest('.search-hit')
        if (li) goto(Number(li.dataset.i))
      })
      panel.addEventListener('click', e => { if (e.target === panel) close() })

      // 快捷键：/ 或 Cmd/Ctrl+K
      document.addEventListener('keydown', e => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); panel.classList.contains('open') ? close() : open() }
        else if (e.key === '/' && !panel.classList.contains('open')) {
          const t = e.target
          if (!(t && t.nodeType === 1 && t.matches('input,textarea'))) { e.preventDefault(); open() }
        }
      })
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && panel.classList.contains('open')) close()
      })
    }
  }

  function escapeHtml(s) { return String(s).replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c])) }
  function escapeRe(s) { return String(s).replace(/[.*+?^${}()|[\]\\]/g, '\\$&') }

  // ══════════════════════════════════════════
  // 8. 专注模式：隐藏导航/目录/页脚，只留正文
  // ══════════════════════════════════════════
  const Focus = {
    KEY: 'focus',
    init() {
      // 顶栏按钮由 Overflow 模块创建（它负责插入到正确位置），这里只绑行为
      Focus.sync()
      document.addEventListener('keydown', e => {
        const t = e.target
        if (t && t.nodeType === 1 && t.matches('input,textarea')) return
        if (e.metaKey || e.ctrlKey || e.altKey) return
        if (e.key.toLowerCase() === 'f') { Focus.toggle(); e.preventDefault() }
      })
      if (store.get(this.KEY, false)) document.documentElement.classList.add('focus-mode')
      // 右下角退出浮标：独立于顶栏，保证专注模式下永远有一个能点的退出入口
      const fab = document.querySelector('.focus-exit-fab')
      if (fab) fab.addEventListener('click', () => Focus.toggle())
      this.sync()
    },
    toggle() {
      const on = !document.documentElement.classList.contains('focus-mode')
      if (on) document.documentElement.classList.add('focus-mode')
      else document.documentElement.classList.remove('focus-mode')
      store.set(this.KEY, on)
      this.sync()
    },
    sync() {
      const on = document.documentElement.classList.contains('focus-mode')
      document.querySelectorAll('.focus-btn').forEach(b => b.classList.toggle('active', on))
    }
  }

  // ══════════════════════════════════════════
  // 9. 字号调节（- / + 或 [ ]）
  // ══════════════════════════════════════════
  const FontSize = {
    KEY: 'fontsize',
    MIN: 13, MAX: 22, STEP: 1,
    init() {
      this.apply(store.get(this.KEY, 16.5))
      document.addEventListener('keydown', e => {
        const t = e.target
        if (t && t.nodeType === 1 && t.matches('input,textarea')) return
        if (e.metaKey || e.ctrlKey || e.altKey) return
        const cur = store.get(this.KEY, 16.5)
        if (e.key === '-' || e.key === '_') { FontSize.set(cur - FontSize.STEP); e.preventDefault() }
        if (e.key === '=' || e.key === '+') { FontSize.set(cur + FontSize.STEP); e.preventDefault() }
      })
    },
    set(v) { FontSize.apply(Math.min(FontSize.MAX, Math.max(FontSize.MIN, v))) },
    apply(v) {
      v = Math.round(v * 10) / 10
      store.set(FontSize.KEY, v)
      document.documentElement.style.setProperty('--fs-base', v + 'px')
    }
  }

  // ══════════════════════════════════════════
  // 10. 顶栏溢出菜单（窄屏时把次要控件收进⋯）
  // ══════════════════════════════════════════
  const Overflow = {
    init() {
      const bar = document.querySelector('.topbar')
      const sw = document.querySelector('.theme-switch')
      if (!bar || !sw) return

      const btn = document.createElement('button')
      btn.className = 'overflow-btn'
      btn.type = 'button'
      btn.title = '更多'
      btn.setAttribute('aria-label', '更多操作')
      btn.textContent = '⋯'

      const panel = document.createElement('div')
      panel.className = 'overflow-panel'

      btn.addEventListener('click', e => {
        e.stopPropagation()
        const open = panel.classList.toggle('open')
        btn.classList.toggle('active', open)
      })
      document.addEventListener('click', () => {
        panel.classList.remove('open')
        btn.classList.remove('active')
      })
      panel.addEventListener('click', e => e.stopPropagation())

      // 把主题切换搬进去
      sw.remove()
      panel.appendChild(sw)
      // 专注按钮也放进去（保留顶栏一个 focus-btn 副本给快捷键用）
      bar.appendChild(btn)
      bar.appendChild(panel)

      // 专注模式需要顶栏留一个可见按钮
      const fb = document.createElement('button')
      fb.className = 'focus-btn focus-btn-top'
      fb.type = 'button'
      fb.title = '专注模式（F）'
      fb.textContent = '专注'
      fb.addEventListener('click', () => Focus.toggle())
      bar.insertBefore(fb, btn)
      Focus.topButton = fb
    }
  }

  // ══════════════════════════════════════════
  // 11. 返回顶部 + 代码复制 + 阅读时长
  // ══════════════════════════════════════════
  const BackTop = {
    init() {
      const btn = document.createElement('button')
      btn.className = 'back-top'
      btn.type = 'button'
      btn.title = '返回顶部'
      btn.setAttribute('aria-label', '返回顶部')
      btn.textContent = '↑'
      document.body.appendChild(btn)
      btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }))
      let last = 0
      window.addEventListener('scroll', () => {
        const y = window.scrollY
        if (y > 500 && y !== last) btn.classList.add('show')
        else if (y <= 500) btn.classList.remove('show')
        last = y
      }, { passive: true })
    }
  }

  const CopyCode = {
    init() {
      document.querySelectorAll('pre').forEach(pre => {
        // 跳过 mermaid fallback pre
        if (pre.closest('.mermaid-err')) return
        const wrap = document.createElement('div')
        wrap.className = 'code-wrap'
        pre.parentNode.insertBefore(wrap, pre)
        wrap.appendChild(pre)
        const btn = document.createElement('button')
        btn.className = 'copy-btn'
        btn.type = 'button'
        btn.textContent = '复制'
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.textContent)
            btn.textContent = '已复制 ✓'
            btn.classList.add('copied')
            setTimeout(() => { btn.textContent = '复制'; btn.classList.remove('copied') }, 1500)
          } catch {
            // 降级：老浏览器用 execCommand
            const ta = document.createElement('textarea')
            ta.value = pre.textContent
            document.body.appendChild(ta)
            ta.select()
            try { document.execCommand('copy') } catch {}
            document.body.removeChild(ta)
            btn.textContent = '已复制 ✓'
            setTimeout(() => { btn.textContent = '复制' }, 1500)
          }
        })
        wrap.appendChild(btn)
      })
    }
  }

  const ReadTime = {
    init() {
      const h1 = document.querySelector('.main h1')
      if (!h1) return
      const main = document.querySelector('.main')
      if (!main) return
      const text = main.textContent || ''
      // 中文阅读速度约 400 字/分钟
      const minutes = Math.max(1, Math.round(text.length / 400))
      const el = document.createElement('div')
      el.className = 'read-time'
      el.textContent = '预计阅读 ' + minutes + ' 分钟 · ' + text.length + ' 字'
      h1.insertAdjacentElement('afterend', el)
    }
  }

  function updateAnsweredStat() {
    const el = document.getElementById('stat-answered')
    if (!el) return
    let n = 0
    const prefix = NS + ':' + UID + ':ans:'
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i)
      if (k && k.startsWith(prefix)) {
        const a = store.get('ans:' + k.slice(prefix.length), {})
        n += Object.keys(a).filter(x => a[x]).length
      }
    }
    el.textContent = n
  }

  // ══════════════════════════════════════════
  // 12. 历年真题：批量展开 + 记忆展开状态
  // ══════════════════════════════════════════
  const Exam = {
    KEY: 'examOpen',
    init() {
      const root = document.querySelector('.exam')
      if (!root) return
      const chapter = root.dataset.examChapter || 'x'

      // 恢复上次展开状态：{ "H07": { "2025年5月": true, ... } }
      const saved = store.get(this.KEY, {}) || {}
      const mine = saved[chapter] || {}
      root.querySelectorAll('.exam-year').forEach(y => {
        const name = y.dataset.examYear
        // 默认：展开最近 1 套（新年优先），其余收起
        const open = (name in mine) ? mine[name] : false
        if (open) y.open = true
        y.addEventListener('toggle', () => {
          mine[name] = y.open
          saved[chapter] = mine
          store.set(this.KEY, saved)
        })
      })
      // 单题的"看过答案"状态也要记（避免重复点开）
      const seen = store.get('examSeen', {}) || {}
      root.querySelectorAll('.exam-q').forEach(qd => {
        const qid = qd.dataset.examId
        if (seen[qid]) {
          const a = qd.querySelector('.exam-ans')
          if (a) a.open = true
        }
        const ans = qd.querySelector('.exam-ans')
        if (ans) ans.addEventListener('toggle', () => {
          if (ans.open) { seen[qid] = 1; store.set('examSeen', seen) }
        })
      })

      // 批量展开/收起按钮
      root.querySelectorAll('.exam-op').forEach(btn => {
        btn.addEventListener('click', e => {
          e.preventDefault()
          const openAll = btn.dataset.examAll === '1'
          root.querySelectorAll('.exam-subject,.exam-year').forEach(d => { d.open = openAll })
          root.querySelectorAll('.exam-ans').forEach(d => {
            d.open = openAll
            if (openAll && d.parentElement.dataset.examId) seen[d.parentElement.dataset.examId] = 1
          })
          if (openAll) store.set('examSeen', seen)
          // 同步年份级记忆
          root.querySelectorAll('.exam-year').forEach(y => { mine[y.dataset.examYear] = y.open })
          saved[chapter] = mine
          store.set(this.KEY, saved)
        })
      })

      // 快捷键：E = 跳到真题区块（不与既有键冲突）
      document.addEventListener('keydown', e => {
        const t = e.target
        if (t && t.nodeType === 1 && t.matches('input,textarea,select,[contenteditable]')) return
        if (e.metaKey || e.ctrlKey || e.altKey) return
        if (e.key.toLowerCase() === 'e') {
          e.preventDefault()
          root.scrollIntoView({ behavior: 'smooth', block: 'start' })
          const y = root.querySelector('.exam-year')
          if (y) y.open = true
        }
      })
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    Theme.init()
    FontSize.init()
    Progress.init()
    ChapBar.init()
    document.querySelectorAll('.quiz-js').forEach(r => Quiz.init(r))
    WrongBook.init()
    Search.init()
    ChapNav.init()
    Focus.init()
    Overflow.init()
    Keys.init()
    BackTop.init()
    CopyCode.init()
    ReadTime.init()
    Exam.init()
    updateAnsweredStat()
    window.addEventListener('quiz:update', updateAnsweredStat)
    renderMermaid()
  })

  // ══════════════════════════════════════════
  // 8. mermaid 渲染（自定义墨绿主题，与正文同色系）
  // ══════════════════════════════════════════
  // 站点配色（与 design.css 的令牌保持一致）
  const MERMAID_LIGHT = {
    bg: '#f2f0e9', fg: '#1b211c', line: '#cdc9bd',
    accent: '#3d5a40', accent2: '#5a8a62', accent3: '#7ea888',
    tip: '#2d6a4f', warn: '#b8860b', danger: '#b33636'
  }
  const MERMAID_DARK = {
    bg: '#1c201d', fg: '#dde5de', line: '#3a413b',
    accent: '#8bb195', accent2: '#a9c9b1', accent3: '#c3dcc8',
    tip: '#7fc79b', warn: '#d9b04a', danger: '#e08585'
  }

  function mermaidTheme(dark) {
    const c = dark ? MERMAID_DARK : MERMAID_LIGHT
    return {
      startOnLoad: false, securityLevel: 'strict',
      fontFamily: 'inherit',
      theme: 'base',
      themeVariables: {
        background: c.bg,
        primaryColor: c.accent + '18',
        primaryTextColor: c.fg,
        primaryBorderColor: c.accent2,
        secondaryColor: c.accent2 + '20',
        tertiaryColor: c.bg,
        lineColor: c.line,
        textColor: c.fg,
        mainBkg: c.accent + '18',
        nodeBorder: c.accent2,
        clusterBkg: c.accent2 + '14',
        clusterBorder: c.line,
        titleColor: c.accent,
        edgeLabelBackground: c.bg,
        // 分类色：全部落在墨绿/暖褐区间，不再是默认紫
        tertiaryColor: c.bg,
        quaternaryColor: c.accent3 + '22',
        noteBkgColor: c.warn + '18',
        noteTextColor: c.fg,
        noteBorderColor: c.warn,
        actorBkg: c.accent2 + '28',
        actorBorder: c.accent,
        actorTextColor: c.fg,
        signalColor: c.fg,
        signalTextColor: c.fg,
        labelBoxBkgColor: c.bg,
        labelTextColor: c.fg,
        loopTextColor: c.fg,
        activationBkgColor: c.accent3 + '30',
        pie1: c.accent, pie2: c.accent2, pie3: c.accent3,
        pie4: c.tip, pie5: c.warn, pie6: c.danger
      },
      flowchart: { htmlLabels: true, curve: 'basis', useMaxWidth: true, padding: 14 },
      sequence: { useMaxWidth: true, actorFontSize: 13, noteFontSize: 12 }
    }
  }

  function renderMermaid() {
    // 覆盖两类节点：未渲染的 .mermaid-src，和已渲染但主题不符的 .mermaid-wrap
    const nodes = [...document.querySelectorAll('.mermaid-src, .mermaid-wrap[data-src]')]
    if (!nodes.length) return

    const dark = document.documentElement.dataset.theme === 'dark'
    const theme = dark ? 'dark' : 'light'

    // ① 图表库未加载（离线 / CDN 挂）→ 优雅降级：把源码摊开显示，别让图凭空消失
    if (!window.mermaid) {
      nodes.forEach(node => {
        const src = node.dataset.src ||
          (node.classList.contains('mermaid-src') ? node.textContent.trim() : '')
        if (!src || node.classList.contains('mermaid-fallback')) return
        node.outerHTML =
          '<div class="mermaid-wrap mermaid-err" data-src="' + escAttr(src) + '">' +
          '<div class="mmd-note">图表库未加载（离线）· 以下为图表源码</div>' +
          '<pre>' + escHtml(src) + '</pre></div>'
      })
      return
    }

    mermaid.initialize(mermaidTheme(dark))

    nodes.forEach((node, i) => {
      const src = node.dataset.src ||
        (node.classList.contains('mermaid-src') ? node.textContent.trim() : '')
      if (!src) return
      // 已按当前主题渲染过 → 跳过
      if (node.classList.contains('mermaid-wrap') && node.dataset.theme === theme) return

      const id = 'mmd' + Date.now().toString(36) + i + Math.random().toString(36).slice(2, 6)
      const mount = (svg) => {
        const holder = document.createElement('div')
        holder.className = 'mermaid-wrap'
        holder.dataset.src = src
        holder.dataset.theme = theme
        holder.innerHTML = svg
        node.replaceWith(holder)
      }
      const fail = (err) => {
        const holder = document.createElement('div')
        holder.className = 'mermaid-wrap mermaid-err'
        holder.dataset.src = src
        holder.dataset.theme = theme
        holder.innerHTML = '<div class="mmd-note">图表渲染失败 · 源码如下</div><pre>' +
          escHtml(src) + '</pre>'
        node.replaceWith(holder)
        console.warn('[mermaid]', err)
      }
      try {
        const res = mermaid.render(id, src)
        if (res && typeof res.then === 'function') res.then(r => mount(r.svg)).catch(fail)
        else mount(res.svg || res)
      } catch (e) { fail(e) }
    })
  }

  function escHtml(s) {
    return String(s).replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]))
  }
  function escAttr(s) {
    return String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]))
  }

  // 主题切换后重渲染图表
  const origApply = Theme.apply
  Theme.apply = function () { origApply(); setTimeout(renderMermaid, 50) }
})()</script>
</body>
</html>